       if (!appState.costingData || appState.costingData.length === 0) {
          select.innerHTML = '<option>No Data Available</option>';
          listContainer.innerHTML = '<div class="alert alert-warning m-3"><i class="fas fa-exclamation-triangle me-2"></i><strong>No Costing Data Found.</strong><br>The "Items costs" tab is currently empty. Please run the syncCostLedger script in your spreadsheet to calculate your pallets.</div>';
          return;
       }

       // Get unique products
       const products = [...new Set(appState.costingData.map(d => d.product))].filter(Boolean).sort();
       
       // If current filter is invalid or 'All', force it to the first valid product
       if (products.length > 0 && (!products.includes(appState.cFilters.product) || appState.cFilters.product === 'All')) {
          appState.cFilters.product = products[0]; 
       }
       
       select.innerHTML = products.map(p => `<option value="${p}" ${appState.cFilters.product === p ? 'selected' : ''}>${p}</option>`).join('');

       renderCostingDashboard();
    }

    function updateCostingState(key, val) {
       appState.cFilters[key] = val;
       renderCostingDashboard();
    }

    function renderCostingDashboard() {
       const rawProductData = appState.costingData.filter(d => d.product === appState.cFilters.product);
       
       // Sort chronologically for timeline math and finding price shifts
       const chronoData = [...rawProductData].sort((a, b) => new Date(a.date) - new Date(b.date));
       
       // --- 1. TIMELINE AGGREGATION FOR CHART ---
       let aggregated = {};
       chronoData.forEach(d => {
          let key = d.date; // Default daily
          if (appState.cFilters.timeline === 'monthly') {
             key = d.date.substring(0, 7); // YYYY-MM
          } else if (appState.cFilters.timeline === 'weekly') {
             let dateObj = new Date(d.date);
             dateObj.setHours(0, 0, 0, 0);
             dateObj.setDate(dateObj.getDate() + 4 - (dateObj.getDay() || 7));
             let weekNo = Math.ceil((((dateObj - new Date(dateObj.getFullYear(), 0, 1)) / 86400000) + 1) / 7);
             key = `${dateObj.getFullYear()}-W${weekNo.toString().padStart(2, '0')}`;
          }
          
          if(!aggregated[key]) { aggregated[key] = { date: key, actSum: 0, mktSum: 0, count: 0 }; }
          aggregated[key].actSum += d.unitActual;
          aggregated[key].mktSum += d.unitMarket;
          aggregated[key].count += 1;
       });

       let chartLabels = [];
       let chartAct = [];
       let chartMkt = [];
       Object.values(aggregated).forEach(a => {
          chartLabels.push(a.date);
          chartAct.push(Number((a.actSum / a.count).toFixed(2)));
          chartMkt.push(Number((a.mktSum / a.count).toFixed(2)));
       });

       const ctx = document.getElementById('costingTrendChart').getContext('2d');
       if(appState.cChartInstance) appState.cChartInstance.destroy();
       
       let datasets = [];
       if (appState.cFilters.view === 'actual' || appState.cFilters.view === 'compare') {
          datasets.push({ label: 'Actual Unit Cost (EGP)', data: chartAct, borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: appState.cFilters.view === 'actual', tension: 0.3, borderWidth: 3 });
       }
       if (appState.cFilters.view === 'market' || appState.cFilters.view === 'compare') {
          datasets.push({ label: 'Market Unit Cost (EGP)', data: chartMkt, borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: appState.cFilters.view === 'market', tension: 0.3, borderWidth: 3, borderDash: appState.cFilters.view === 'compare' ? [5, 5] : [] });
       }

       appState.cChartInstance = new Chart(ctx, {
          type: 'line',
          data: { labels: chartLabels, datasets: datasets },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: false } } }
       });

       // --- 2. ISOLATE PRICE SHIFTS FOR THE LIST ---
       let changeEvents = [];
       let lastActual = null;
       let lastMarket = null;

       for (let i = 0; i < chronoData.length; i++) {
          let d = chronoData[i];
          // Only save to the side list if it is the first record OR if the price moved
          if (i === 0 || d.unitActual !== lastActual || d.unitMarket !== lastMarket) {
             changeEvents.push({ ...d, isFirst: i === 0 });
             lastActual = d.unitActual;
             lastMarket = d.unitMarket;
          }
       }
       // Reverse to show the most recent shifts at the top
       changeEvents.reverse();

       const listContainer = document.getElementById('costing-runs-list');
       if(changeEvents.length === 0) { listContainer.innerHTML = '<div class="text-center text-muted p-3">No production history.</div>'; return; }
       
       listContainer.innerHTML = changeEvents.map(d => {
          let mainVal = appState.cFilters.view === 'market' ? d.unitMarket : d.unitActual;
          let diffStr = '';
          if (appState.cFilters.view === 'compare') {
             let diff = d.unitMarket - d.unitActual;
             let cColor = diff > 0 ? 'text-danger' : (diff < 0 ? 'text-success' : 'text-muted');
             let cSign = diff > 0 ? '+' : '';
             diffStr = `<span class="${cColor} small fw-bold ms-2" style="font-size: 0.75rem;">(${cSign}${diff.toFixed(2)})</span>`;
          }
          let badgeHtml = d.isFirst ? `<span class="badge bg-secondary ms-1">Initial</span>` : `<span class="badge bg-warning text-dark ms-1"><i class="fas fa-bolt"></i> Price Shift</span>`;
          return `
          <div class="p-3 bg-light border rounded-3 mb-2 d-flex justify-content-between align-items-center client-card" onclick="openBomModal('${d.planId}')">
             <div>
                <div class="fw-bold text-dark" style="font-size: 0.9rem;">${d.date} ${badgeHtml}</div>
                <div class="small text-muted mt-1">Ref: ${d.planId}</div>
             </div>
             <div class="text-end">
                <div class="fw-bold text-primary fs-6">${mainVal.toFixed(2)} EGP ${diffStr}</div>
                <div class="small text-muted mt-1 border-bottom border-primary d-inline-block" style="cursor:pointer">View BOM</div>
             </div>
          </div>`;
       }).join('');
    }

    function openBomModal(planId) {
       // Search by specific Plan ID rather than index to guarantee accuracy
       const data = appState.costingData.find(d => d.planId === planId);
       if (!data) return;

       document.getElementById('bom-modal-product').innerText = data.product;
       document.getElementById('bom-modal-date').innerText = `${data.date} (${data.planId})`;
       document.getElementById('bom-modal-qty').innerText = data.qty.toLocaleString();

       const allMats = new Set([...Object.keys(data.bomActual || {}), ...Object.keys(data.bomMarket || {})]);
       const sortedMats = Array.from(allMats).sort();
       
       let tBody = '';
       let actData = [];
       let mktData = [];

       sortedMats.forEach(mat => {
          let act = data.bomActual[mat] || 0;
          let mkt = data.bomMarket[mat] || 0;
          actData.push(act);
          mktData.push(mkt);

          let diff = mkt - act;
          let cColor = diff > 0 ? 'text-danger' : (diff < 0 ? 'text-success' : 'text-muted');
          let cSign = diff > 0 ? '+' : '';
          
          tBody += `
          <tr>
             <td class="fw-bold text-dark">${mat}</td>
             <td class="text-end text-primary fw-bold">${act.toFixed(2)}</td>
             <td class="text-end text-danger fw-bold">${mkt.toFixed(2)}</td>
             <td class="text-end ${cColor} fw-bold">${cSign}${diff.toFixed(2)}</td>
          </tr>`;
       });
       document.getElementById('bom-modal-table-body').innerHTML = tBody;

       const ctx = document.getElementById('bomChart').getContext('2d');
       if(appState.bomChartInstance) appState.bomChartInstance.destroy();
       
       appState.bomChartInstance = new Chart(ctx, {
          type: 'bar',
          data: {
             labels: sortedMats,
             datasets: [
                { label: 'Actual Unit Cost', data: actData, backgroundColor: '#3b82f6', borderRadius: 4 },
                { label: 'Market Unit Cost', data: mktData, backgroundColor: '#ef4444', borderRadius: 4 }
             ]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' } } }
       });

       new bootstrap.Modal(document.getElementById('bomModal')).show();
    }
function triggerCostingSyncConfirm(event) {
       event.stopPropagation(); // Prevent opening the report
       document.getElementById('btn-costing-sync').classList.add('d-none');
       const confirmBox = document.getElementById('costing-sync-confirm');
       confirmBox.classList.remove('d-none');
       confirmBox.classList.add('d-flex');
    }

    function cancelCostingSync(event) {
       if (event) event.stopPropagation();
       const confirmBox = document.getElementById('costing-sync-confirm');
       confirmBox.classList.remove('d-flex');
       confirmBox.classList.add('d-none');
       document.getElementById('btn-costing-sync').classList.remove('d-none');
    }

    function executeCostingSync(event) {
       event.stopPropagation();
       const confirmBox = document.getElementById('costing-sync-confirm');
       
       // Change inline UI to loading spinner
       confirmBox.innerHTML = '<span class="small fw-bold text-primary px-3 py-1" style="font-size:0.75rem;"><i class="fas fa-spinner fa-spin me-2"></i>Recalculating...</span>';
       
       google.script.run
         .withSuccessHandler(res => {
            // Change inline UI to success message
            confirmBox.innerHTML = '<span class="small fw-bold text-success px-3 py-1" style="font-size:0.75rem;"><i class="fas fa-check me-2"></i>Synced!</span>';
            
            setTimeout(() => {
               // Restore the original HTML inside the confirm box so it works next time
               cancelCostingSync(null);
               confirmBox.innerHTML = '<span class="small fw-bold text-danger px-2" style="font-size:0.7rem; white-space:nowrap;">Clear & Sync?</span><button class="btn btn-sm btn-danger rounded-circle p-0 d-flex justify-content-center align-items-center shadow-sm" style="width:22px;height:22px;font-size:0.6rem; border:none;" onclick="executeCostingSync(event)"><i class="fas fa-check"></i></button><button class="btn btn-sm btn-light rounded-circle p-0 d-flex justify-content-center align-items-center ms-1 border shadow-sm" style="width:22px;height:22px;font-size:0.6rem;" onclick="cancelCostingSync(event)"><i class="fas fa-times text-muted"></i></button>';
               
               // Automatically launch the dashboard
               loadSource('costing');
            }, 1200);
         })
         .withFailureHandler(err => {
            // Change inline UI to Error message
            confirmBox.innerHTML = '<span class="small fw-bold text-danger px-3 py-1" style="font-size:0.75rem;"><i class="fas fa-exclamation-triangle me-2"></i>Error</span>';
            setTimeout(() => { cancelCostingSync(null); }, 2500);
         })
         .forceResyncCostLedger();
    }
  </script>
