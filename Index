    function getProductCategory(item) {
        if (item.includes('خل') && !item.includes('تفاح')) return 'Vinegar';
        if (item.includes('طحينة') || item.includes('طحينه')) return 'Tahini';
        if (item.includes('ارز') || item.includes('أرز') || item.includes('رز')) return 'Rice';
        return 'Others';
    }

    // Assigns a consistent pale color based on the segment name
    function getSegmentColorClass(segment) {
        // Removed 'dark', 'secondary', and 'light' to guarantee no grey/dull colors
        const colors = ['primary', 'success', 'danger', 'warning', 'info'];
        let hash = 0;
        for (let i = 0; i < segment.length; i++) { hash = segment.charCodeAt(i) + ((hash << 5) - hash); }
        let c = colors[Math.abs(hash) % colors.length];
        let textC = (c === 'warning' || c === 'info') ? 'text-dark' : `text-${c}`;
        return `bg-${c} bg-opacity-10 ${textC} border border-${c} border-opacity-25`;
    }

    function processClientCadence(data) {
        let grouped = {};
        data.forEach(row => {
            let cat = getProductCategory(row.item);
            let client = row.client;
            
            let d = new Date(row.date); d.setHours(0, 0, 0, 0);
            let dateKey = d.getTime();

            if (!grouped[client]) grouped[client] = {};
            if (!grouped[client][cat]) grouped[client][cat] = {};
            
            if (!grouped[client][cat][dateKey]) {
                grouped[client][cat][dateKey] = {
                    date: dateKey, totalQty: 0, segment: row.segment, 
                    region: row.region, contact: row.contactInfo, items: []
                };
            }

            grouped[client][cat][dateKey].totalQty += row.qty;
            
            let existingItem = grouped[client][cat][dateKey].items.find(i => i.name === row.item);
            if (existingItem) existingItem.qty += row.qty;
            else grouped[client][cat][dateKey].items.push({ name: row.item, qty: row.qty });
        });

        let alerts = [];
        let todayMs = Date.now();
        const msPerDay = 1000 * 60 * 60 * 24;

        for (let client in grouped) {
            for (let cat in grouped[client]) {
                let orders = Object.values(grouped[client][cat]).sort((a, b) => a.date - b.date);
                if (orders.length < 2) continue;

                let recentOrders = orders.slice(-6); 
                let firstOfRecent = recentOrders[0];
                let lastOrder = recentOrders[recentOrders.length - 1];

                let daysElapsed = (lastOrder.date - firstOfRecent.date) / msPerDay;
                if (daysElapsed <= 0) continue;

                let totalConsumedQty = 0;
                for (let i = 0; i < recentOrders.length - 1; i++) {
                    totalConsumedQty += recentOrders[i].totalQty;
                }
                if (totalConsumedQty <= 0) continue;

                let dcr = totalConsumedQty / daysElapsed; 
                let expectedInterval = lastOrder.totalQty / dcr; 
                let expectedNextDateMs = lastOrder.date + (expectedInterval * msPerDay);
                let daysLate = (todayMs - expectedNextDateMs) / msPerDay;

                if (daysLate > 0) {
                    alerts.push({
                        client: client,
                        segment: lastOrder.segment,
                        region: lastOrder.region,
                        contact: lastOrder.contact,
                        category: cat,
                        lastOrderDate: lastOrder.date,
                        lastOrderQty: lastOrder.totalQty,
                        expectedInterval: Math.round(expectedInterval),
                        daysLate: Math.floor(daysLate),
                        history: recentOrders.slice(-5).reverse() 
                    });
                }
            }
        }
        return alerts;
    }

