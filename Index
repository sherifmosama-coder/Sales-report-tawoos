    window.submitMarketUpdate = function() {
        let btn = document.getElementById('mu-submit-btn');
        let date = document.getElementById('mu-date').value;
        let mat = document.getElementById('mu-material').value;
        let price = document.getElementById('mu-price').value;
        
        if(!date || !mat || !price) { alert("Please fill out the Date, Material, and New Price fields."); return; }
        
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Saving & Resyncing Engine...';
        
        google.script.run.withSuccessHandler(res => {
            bootstrap.Modal.getInstance(document.getElementById('marketUpdateModal')).hide();
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save me-2"></i>Commit Update';
            
            // Reload the entire dashboard to inject the new data!
            document.getElementById('smart-loader').style.display = 'flex';
            document.getElementById('costing-view-container').style.display = 'none';
            document.getElementById('loader-insight').innerText = "Update successful! Re-drawing margin charts...";
            loadSource('costing');
        }).withFailureHandler(err => {
            alert("Error: " + err.message);
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save me-2"></i>Commit Update';
        }).saveAndResyncMarketPrice(date, mat, price);
    };

    // --- NEW: ACTION SCANNER & FLIGHT ENGINE ---
    appState.hasFlown = false;
    appState.globalAlerts = [];
    
    // Run the scanner every time the dashboard draws, but only fly once!
    const originalRenderCosting = renderCostingDashboard;
    renderCostingDashboard = function() {
        originalRenderCosting();
        setTimeout(runActionScanner, 500); 
    };

    function runActionScanner() {
        let chronoData = [...appState.costingData].sort((a,b) => new Date(a.date) - new Date(b.date));
        let matHistory = {};
        
        if (chronoData.length === 0) return;
        
        // 1. Define the Time Window (Last 14 Days)
        let globalLatestMs = new Date(chronoData[chronoData.length - 1].date).getTime();
        let lookbackMs = globalLatestMs - (14 * 24 * 60 * 60 * 1000); 

        chronoData.forEach(d => {
            let dateMs = new Date(d.date).getTime();
            if (d.bomMeta) {
                Object.keys(d.bomMeta).forEach(mat => {
                    let a = d.bomMeta[mat].actRate || 0;
                    let m = d.bomMeta[mat].mktRate || d.bomMeta[mat].rate || 0;
                    if (a > 0 || m > 0) {
                        if (!matHistory[mat]) matHistory[mat] = [];
                        matHistory[mat].push({ act: a, mkt: m, dateMs: dateMs });
                    }
                });
            }
        });

        let alerts = [];

        Object.keys(matHistory).forEach(mat => {
            let history = matHistory[mat];
            if (history.length < 1) return;
            
            let latest = history[history.length - 1];
            
            // 2. Find the Baseline Rate (The price active exactly 14 days ago)
            let baselineAct = history[0].act; 
            for (let i = history.length - 1; i >= 0; i--) {
                if (history[i].dateMs < lookbackMs) {
                    baselineAct = history[i].act;
                    break;
                }
            }
            // Fallback: If the material is brand new (first bought within 14 days), use its first price
            if (history[0].dateMs >= lookbackMs) {
                baselineAct = history[0].act;
            }
            
            let isManualOverride = Math.abs(latest.act - latest.mkt) > 0.01;
            let pct = 0; let isAlert = false; let alertType = '';

            // 3. Logic: Check Manual Override first, then check 14-Day Actual Inflation
            if (isManualOverride && latest.act > 0) {
                pct = ((latest.mkt - latest.act) / latest.act) * 100;
                if (Math.abs(pct) > 2.0) { isAlert = true; alertType = 'Manual Forecast'; }
            } else if (baselineAct > 0) {
                pct = ((latest.act - baselineAct) / baselineAct) * 100;
                if (Math.abs(pct) > 2.0) { isAlert = true; alertType = 'Actual Shift (14d)'; }
            }

            if (isAlert) {
                alerts.push({ mat: mat, pct: pct, type: alertType, mkt: latest.mkt });
            }
        });

        alerts.sort((a,b) => Math.abs(b.pct) - Math.abs(a.pct));
        appState.globalAlerts = alerts;

        let badge = document.getElementById('volatility-badge');

        if (alerts.length > 0) {
            badge.innerText = alerts.length;
            badge.classList.remove('d-none');
            
            if (!appState.hasFlown) {
                appState.hasFlown = true;
                triggerFlightSequence(alerts);
            }
        } else {
            badge.classList.add('d-none');
        }
    }

    function triggerFlightSequence(alerts) {
        let card = document.getElementById('flying-alert-card');
        let btn = document.getElementById('volatility-btn');
        let badge = document.getElementById('volatility-badge');
        
        let top3 = alerts.slice(0, 3);
        let html = top3.map(a => {
            let color = a.pct > 0 ? 'text-danger' : 'text-success';
            let icon = a.pct > 0 ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down';
            let tag = a.type === 'Manual Forecast' ? '<span class="badge bg-danger ms-2" style="font-size:0.5rem;">Forecast</span>' : '';
            return `
            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
               <div class="fw-bold text-dark text-truncate" style="font-size: 0.8rem; max-width: 180px;">${a.mat} ${tag}</div>
               <div class="fw-bold ${color}" style="font-size: 0.9rem;"><i class="fas ${icon} me-1"></i>${Math.abs(a.pct).toFixed(1)}%</div>
            </div>`;
        }).join('');
        
        if (alerts.length > 3) html += `<div class="text-center text-muted fw-bold small mt-1">+${alerts.length - 3} more...</div>`;
        document.getElementById('flying-alert-content').innerHTML = html;

        card.style.transition = 'none';
        card.style.transform = 'translate(-50%, -50%) scale(1)';
        card.style.opacity = '0';
        
        void card.offsetWidth; // Reflow
        
        card.style.transition = 'transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease-in-out';
        card.style.opacity = '1';

        setTimeout(() => {
            let cardRect = card.getBoundingClientRect();
            let btnRect = btn.getBoundingClientRect();
            
            let deltaX = (btnRect.left + btnRect.width/2) - (window.innerWidth / 2);
            let deltaY = (btnRect.top + btnRect.height/2) - (window.innerHeight / 2);

            card.style.transform = `translate(calc(-50% + ${deltaX}px), calc(-50% + ${deltaY}px)) scale(0.1)`;
            card.style.opacity = '0';

            setTimeout(() => {
                badge.classList.remove('badge-pulse');
                void badge.offsetWidth; 
                badge.classList.add('badge-pulse');
            }, 800); 

        }, 3000); 
    }

    // --- NEW: UI CLICK ROUTING ---
    window.openActionAlertsModal = function() {
        if(appState.globalAlerts.length === 0) {
            alert("All materials are stable. No cost shifts > 2% detected.");
            return;
        }
        
        let html = appState.globalAlerts.map(a => {
            let color = a.pct > 0 ? 'text-danger' : 'text-success';
            let icon = a.pct > 0 ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down';
            let tag = a.type === 'Manual Forecast' ? '<span class="badge bg-danger ms-2" style="font-size:0.55rem;">Forecast</span>' : '';
            let safeMat = a.mat.replace(/'/g, "\\'");
            return `
            <div class="p-3 bg-white border rounded-3 mb-2 d-flex justify-content-between align-items-center" style="cursor:pointer; transition: all 0.2s;" onclick="routeToActionDrilldown('${safeMat}')" onmouseover="this.classList.add('shadow-sm', 'bg-light'); this.classList.remove('bg-white');" onmouseout="this.classList.remove('shadow-sm', 'bg-light'); this.classList.add('bg-white');">
               <div>
                  <div class="fw-bold text-dark" style="font-size: 0.85rem;">${a.mat} ${tag}</div>
                  <div class="small text-muted mt-1"><i class="fas fa-chart-line me-1 text-primary"></i>View Full Timeline</div>
               </div>
               <div class="text-end">
                  <div class="fw-bold ${color}" style="font-size: 0.95rem;"><i class="fas ${icon} me-1"></i>${Math.abs(a.pct).toFixed(1)}%</div>
               </div>
            </div>`;
        }).join('');
        
        document.getElementById('action-alerts-body').innerHTML = html;
        new bootstrap.Modal(document.getElementById('actionAlertsModal')).show();
    };

    window.routeToActionDrilldown = function(matName) {
        // Hide the alerts list modal first
        let modalEl = document.getElementById('actionAlertsModal');
        let modalInst = bootstrap.Modal.getInstance(modalEl);
        if(modalInst) modalInst.hide();
        
        // Wait 400ms for Bootstrap transition to clear the backdrop, then launch the Timeline!
        setTimeout(() => {
            openMaterialHistory(matName);
        }, 400);
    };
  </script>
