             if (targetId === 'target') aggData[key].baseline += (item.target || 0);
             else if (targetId !== 'current') aggData[key].baseline += (item.comp[targetId] || 0);
          });
       }
       const sortedArr = Object.values(aggData).sort((a, b) => b.curr - a.curr);
       const measure = document.querySelector('input[name="measure"]:checked').value;
       const fmt = (n) => measure === 'rev' ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'EGP', maximumFractionDigits:0 }).format(n) : formatK(n);

       // 3. Render View
       if (type === 'value') {
