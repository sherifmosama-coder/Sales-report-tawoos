    // ==========================================
    // COSTING DRILL-DOWN INSPECTOR
    // ==========================================
    function openTransactionInspector() {
        if (!appState.activeInspectPeriod) return;
        
        let p = appState.activeInspectPeriod;
        let product = appState.cFilters.product;
        
        document.getElementById('inspectorModalTitle').innerHTML = 
            `<i class="fas fa-microscope text-primary me-2"></i>Lineage: ${product} 
             <span class="badge bg-secondary ms-2" style="font-size: 0.7rem;">${p.dateLabel} Period</span>`;
             
        const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'EGP', maximumFractionDigits: 1 });
        
        // --- 1. BUILD SALES LEDGER TAB ---
        let salesInPeriod = (appState.netSalesData || []).filter(s => 
             s.product === product && s.dateMs >= p.startMs && s.dateMs <= p.endMs
        );
        
        let sHtml = '';
        if (salesInPeriod.length === 0) {
            sHtml = `<tr><td colspan="7" class="text-center py-4 text-muted"><i class="fas fa-folder-open mb-2 fs-3 opacity-50"></i><br>No sales recorded for this product during this exact period.</td></tr>`;
        } else {
            salesInPeriod.forEach(s => {
                let marginBadge = s.backMarginApplied > 0 ? `<span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">${(s.backMarginApplied*100).toFixed(1)}%</span>` : `<span class="text-muted">-</span>`;
                sHtml += `
                    <tr>
                        <td class="ps-3 fw-bold" style="font-size: 0.8rem;">${s.date}</td>
                        <td style="font-size: 0.8rem;">${s.client}</td>
                        <td class="text-center fw-bold" style="font-size: 0.8rem;">${s.qty.toLocaleString()}</td>
                        <td class="text-end text-muted" style="font-size: 0.8rem;">${fmt.format(s.grossRev)}</td>
                        <td class="text-center">${marginBadge}</td>
                        <td class="text-end fw-bold text-success" style="font-size: 0.8rem;">${fmt.format(s.netRev)}</td>
                        <td class="text-end pe-3 fw-bold text-dark" style="font-size: 0.8rem;">${s.netAsp > 0 ? fmt.format(s.netAsp) : '--'}</td>
                    </tr>`;
            });
        }
        document.getElementById('inspector-sales-body').innerHTML = sHtml;
        
        // --- 2. BUILD COSTS (BOM) TAB (GLOBAL CHRONOLOGICAL KNOWLEDGE) ---
        let cHtml = '';
        let totalCost = 0;
        let hybridBomEntries = [];

        // 1. Uncouple BOM timeline from Sales timeline
        let bomEvalMs = p.bomEvalMs || p.endMs;

        // 2. Build Global Material Ledger (Harvests newest prices across ALL products up to bomEvalMs)
        let globalLedger = {};
        appState.costingData.forEach(d => {
            let eventMs = new Date(d.date).getTime();
            if (eventMs <= bomEvalMs && d.bomMeta) {
                Object.keys(d.bomMeta).forEach(mat => {
                    if (mat === '_isVatExempt') return;
                    let meta = d.bomMeta[mat];
                    if (!globalLedger[mat]) globalLedger[mat] = { actDateMs: 0, actRate: 0, mktDateMs: 0, mktRate: 0, actBaseRate: 0, actVatRate: 0 };
                    
                    if (meta.actDateMs && meta.actDateMs <= bomEvalMs) {
                        if (meta.actDateMs > globalLedger[mat].actDateMs || (meta.actDateMs === globalLedger[mat].actDateMs && meta.actBaseRate > 0)) {
                            globalLedger[mat].actDateMs = meta.actDateMs; globalLedger[mat].actRate = meta.actRate;
                            if (meta.actBaseRate > 0) { globalLedger[mat].actBaseRate = meta.actBaseRate; globalLedger[mat].actVatRate = meta.actVatRate; }
                        }
                    }
                    if (meta.mktRate > 0 && meta.mktDateMs && meta.mktDateMs <= bomEvalMs) {
                        if (meta.mktDateMs > globalLedger[mat].mktDateMs) {
                            globalLedger[mat].mktDateMs = meta.mktDateMs; globalLedger[mat].mktRate = meta.mktRate;
                        }
                    }
                });
            }
        });

        // 3. Evaluate BOM using Recipe from snapshot, but Prices from Global Ledger
        if (p.bomEvent && p.bomEvent.bomMeta) {
            Object.keys(p.bomEvent.bomMeta).forEach(mat => {
                if (mat === '_isVatExempt') return;
                let localMeta = p.bomEvent.bomMeta[mat];
                let gMeta = globalLedger[mat] || localMeta; // Fallback to snapshot if not in ledger
                
                let actMs = gMeta.actDateMs || 0;
                let mktMs = gMeta.mktDateMs || 0;
                
                // DYNAMIC VAT ROUTING
                let isVatExempt = p.bomEvent.bomMeta._isVatExempt;
                let resolvedActRate = gMeta.actRate;
                if (gMeta.actBaseRate > 0) { resolvedActRate = isVatExempt ? gMeta.actVatRate : gMeta.actBaseRate; }
                
                let useMarket = mktMs > actMs;
                let activeDateMs = useMarket ? mktMs : actMs;
                let rate = useMarket ? gMeta.mktRate : resolvedActRate;
                
                // Reverse-engineer the recipe Qty from the event's stored snapshot costs
                let actCost = p.bomEvent.bomActual ? (p.bomEvent.bomActual[mat] || 0) : 0;
                let mktCost = p.bomEvent.bomMarket ? (p.bomEvent.bomMarket[mat] || 0) : 0;
                let qtyUsed = 0;
                if (localMeta.actRate > 0 && actCost > 0) qtyUsed = actCost / localMeta.actRate;
                else if (localMeta.mktRate > 0 && mktCost > 0) qtyUsed = mktCost / localMeta.mktRate;
                
                let cost = qtyUsed * rate;
                
                if (cost > 0) {
                    // BUGFIX: Changed 'meta.unit' to 'localMeta.unit'
                    hybridBomEntries.push({ mat, cost, rate, qtyUsed, useMarket, activeDateMs, unit: localMeta.unit || '' });
                }
            });
        }

        // Sort from most expensive ingredient to least
        hybridBomEntries.sort((a, b) => b.cost - a.cost);

        hybridBomEntries.forEach(item => {
            totalCost += item.cost;
            let formattedQty = item.qtyUsed > 0 ? item.qtyUsed.toFixed(4).replace(/\.?0+$/, '') : '--';
            
            let dateStr = '--';
            let sourceBadge = '';
            
            if (item.activeDateMs > 0) {
                dateStr = new Date(item.activeDateMs).toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'2-digit'});
                if (item.useMarket) {
                    sourceBadge = '<span class="badge bg-warning bg-opacity-10 text-warning border border-warning ms-1" style="font-size:0.55rem;" title="Manual Market Override">MKT</span>';
                } else {
                    sourceBadge = '<span class="badge bg-primary bg-opacity-10 text-primary border border-primary ms-1" style="font-size:0.55rem;" title="Actual Purchase Invoice">INV</span>';
                }
            }
            
            cHtml += `
                <tr>
                    <td class="ps-3 fw-bold" style="font-size: 0.8rem;">${item.mat}</td>
                    <td class="text-center text-muted" style="font-size: 0.8rem;">${formattedQty} <span style="font-size: 0.65rem;">${item.unit}</span></td>
                    <td class="text-center text-dark" style="font-size: 0.75rem;">${dateStr} <br>${sourceBadge}</td>
                    <td class="text-end" style="font-size: 0.8rem;">${fmt.format(item.rate)}</td>
                    <td class="text-end pe-3 fw-bold text-danger" style="font-size: 0.8rem;">${fmt.format(item.cost)}</td>
                </tr>`;
        });
        
        // --- ADD TOTAL ROW ---
        if (hybridBomEntries.length > 0) {
            cHtml += `
                <tr class="table-light border-top border-2">
                    <td colspan="4" class="text-end fw-bold text-dark ps-3 py-3" style="font-size: 0.85rem;">TOTAL BOM COST:</td>
                    <td class="text-end pe-3 fw-bold text-danger py-3" style="font-size: 0.95rem;">${fmt.format(totalCost)}</td>
                </tr>`;
        } else {
            cHtml = `<tr><td colspan="5" class="text-center py-4 text-muted">No bill of materials data available for this date.</td></tr>`;
        }

        document.getElementById('inspector-costs-body').innerHTML = cHtml;
        
        // Show Modal
        new bootstrap.Modal(document.getElementById('transactionInspectorModal')).show();
    }

