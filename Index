       // Render Chart
       const ctx = document.getElementById('modalChart').getContext('2d');
       if(appState.modalChartInstance) appState.modalChartInstance.destroy();
       appState.modalChartInstance = new Chart(ctx, { type:'bar', data:{labels:lbl, datasets:[{label:'Qty', data:dta, backgroundColor:bg}]}, options:{plugins:{legend:{display:false}}, scales:{x:{grid:{display:false}}}}});
       m.show();
    }

    function formatK(n) { return n>=1000?(n/1000).toFixed(1)+'k':n.toLocaleString(); }
    function parseDate(s) { 
      if (!s || s === "0000-00-00") return null; 

      // 1. Standard ISO Date (YYYY-MM-DD) - Coming from New Source
      // We check if it starts with 4 digits followed by dash or slash
      if (/^\d{4}[-\/]\d{2}[-\/]\d{2}/.test(s)) {
        // Create date explicitly to avoid Timezone shifts
        const parts = s.split(/[-\/]/); // Split by - or /
        // new Date(Year, MonthIndex, Day) -> Month is 0-11
        return new Date(parts[0], parts[1] - 1, parts[2]); 
      }
      
      // 2. Legacy Arabic Format (DD-MonthName-YYYY)
      const m={"يناير":0,"فبراير":1,"مارس":2,"أبريل":3,"مايو":4,"يونيو":5,"يوليو":6,"أغسطس":7,"سبتمبر":8,"أكتوبر":9,"نوفمبر":10,"ديسمبر":11};
      try {
        const p = s.split('-');
        return p.length===3 ? new Date(p[2], m[p[1]]||0, p[0]) : new Date(s);
      } catch (e) { return null; }
    }

// --- PRODUCT DASHBOARD ENGINE ---
    function renderProductDashboard() {
      const data = appState.productData;
      if (!data || data.length === 0) return;

      const dateInput = document.getElementById('report-date').value;
      if (!dateInput) return;
      const refDate = new Date(dateInput);
      
      const timeframe = document.querySelector('input[name="timeframe"]:checked').value;
      const measure = document.querySelector('input[name="measure"]:checked').value;
      const { segment, category, line, item } = appState.pFilters;

      const currentYear = refDate.getFullYear();

      // 1. Define Current Time Range (For KPIs & Detailed View)
      let startCurr, endCurr;
      if (timeframe === 'year') {
         startCurr = new Date(currentYear, 0, 1); endCurr = refDate;
      } else if (timeframe === 'quarter') {
         const q = Math.floor(refDate.getMonth() / 3);
         startCurr = new Date(currentYear, q * 3, 1); endCurr = refDate;
      } else { // Month
         startCurr = new Date(currentYear, refDate.getMonth(), 1); endCurr = refDate;
      }

      // 2. Define Comparison Ranges (For KPIs & Detailed View)
      let comparisons = appState.pCompareYears.map(y => {
         let s, e;
         if (timeframe === 'year') {
            s = new Date(y, 0, 1); e = new Date(y, refDate.getMonth(), refDate.getDate());
         } else if (timeframe === 'quarter') {
            const q = Math.floor(refDate.getMonth() / 3);
            s = new Date(y, q * 3, 1); e = new Date(y, refDate.getMonth(), refDate.getDate());
         } else {
            s = new Date(y, refDate.getMonth(), 1); e = new Date(y, refDate.getMonth(), refDate.getDate());
         }
         return { year: y, start: s, end: e, total: 0, trend: {} };
      });

      // 3. Prepare Periodic & Global Trend Structures
      let periodicBuckets = [];
      const mNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      
      if (timeframe === 'year') periodicBuckets = ['YTD'];
      if (timeframe === 'quarter') {
         const currentQ = Math.floor(refDate.getMonth() / 3) + 1;
         for(let i=1; i<=currentQ; i++) periodicBuckets.push('Q'+i);
      }
      if (timeframe === 'month') {
         for(let i=0; i<=refDate.getMonth(); i++) periodicBuckets.push(mNames[i]);
      }

      let pData = { curr: {} };
      let yTrend = { curr: {}, comp: {} };
      comparisons.forEach(c => { pData[c.year] = {}; yTrend.comp[c.year] = {}; });

      const getBucket = (d) => {
         if (timeframe === 'year') return 'YTD';
         if (timeframe === 'quarter') return 'Q' + (Math.floor(d.getMonth() / 3) + 1);
         return mNames[d.getMonth()];
      };

      // 4. Filter, Aggregate, and Calculate Target Profiles
      let currTotal = 0; let currItems = {}; let currTrend = {};
      let itemProfiles = {}; // For Old vs New target logic
      appState.pMasterItems = {};
      appState.pMasterSegments = {};
      // Reset Master Tracker for Modal

      const initMasterItem = (name, cat, line) => {
         if (!appState.pMasterItems[name]) {
            appState.pMasterItems[name] = { name: name, category: cat, line: line, curr: 0, target: 0, comp: {} };
         }
      };

      const isMatch = (d) => {
         if (category !== 'All' && d.category !== category) return false;
         const isPrivate = (d.line === true || String(d.line).toUpperCase() === 'TRUE');
         if (line === 'Own' && isPrivate) return false;
         if (line === 'Private' && !isPrivate) return false;
         if (item !== 'All' && d.item !== item) return false;
         return true;
      };

      data.forEach(d => {
         if (!isMatch(d)) return;
         
         // NEW: Determine value dynamically based on Segment Mode
         let val = 0;
         if (segment === 'All') {
            val = measure === 'qty' ? d.qty : d.rev;
         } else {
            if (d.segments && d.segments[segment]) {
               val = d.segments[segment][measure] || 0;
            }
         }
         
         if (val === 0) return; // Skip logic if segment had no volume

         const dDate = new Date(d.date); dDate.setHours(0,0,0,0);
         const dayKey = ('0' + (dDate.getMonth()+1)).slice(-2) + '-' + ('0' + dDate.getDate()).slice(-2);
         const dYear = dDate.getFullYear();

         // Track Item Profiles (Old vs New)
         if (!itemProfiles[d.item]) itemProfiles[d.item] = { name: d.item, category: d.category, line: d.line, prevDaily: {}, currMonthly: Array(12).fill(0), isOld: false };
         if (dYear === currentYear - 1) {
            itemProfiles[d.item].prevDaily[dayKey] = (itemProfiles[d.item].prevDaily[dayKey] || 0) + val;
            if (val > 0) itemProfiles[d.item].isOld = true;
         }
         if (dYear === currentYear) {
            itemProfiles[d.item].currMonthly[dDate.getMonth()] += val;
         }

         // Detailed Math (KPIs)
         if (dDate >= startCurr && dDate <= endCurr) {
            currTotal += val;
            if(!currItems[d.item]) currItems[d.item] = 0;
            currItems[d.item] += val;
            currTrend[dayKey] = (currTrend[dayKey] || 0) + val;
            initMasterItem(d.item, d.category, d.line);
            appState.pMasterItems[d.item].curr += val;

            // NEW: Track Segments for Drill-Down Modal
            if (segment === 'All' && d.segments) {
               Object.keys(d.segments).forEach(seg => {
                  let sVal = measure === 'qty' ? (d.segments[seg].qty||0) : (d.segments[seg].rev||0);
                  if (sVal !== 0) {
                     if (!appState.pMasterSegments[seg]) appState.pMasterSegments[seg] = { name: seg, curr: 0, target: 0, comp: {} };
                     appState.pMasterSegments[seg].curr += sVal;
                  }
               });
            }
         }
         comparisons.forEach(comp => {
            if (dDate >= comp.start && dDate <= comp.end) {
               comp.total += val;
               comp.trend[dayKey] = (comp.trend[dayKey] || 0) + val;
               initMasterItem(d.item, d.category, d.line);
               appState.pMasterItems[d.item].comp[comp.year] = (appState.pMasterItems[d.item].comp[comp.year] || 0) + val;

               // NEW: Track Segments for Drill-Down Modal
               if (segment === 'All' && d.segments) {
                  Object.keys(d.segments).forEach(seg => {
                     let sVal = measure === 'qty' ? (d.segments[seg].qty||0) : (d.segments[seg].rev||0);
                     if (sVal !== 0) {
                        if (!appState.pMasterSegments[seg]) appState.pMasterSegments[seg] = { name: seg, curr: 0, target: 0, comp: {} };
                        appState.pMasterSegments[seg].comp[comp.year] = (appState.pMasterSegments[seg].comp[comp.year] || 0) + sVal;
                     }
                  });
               }
            }
         });

         // Periodic Math (Full Horizon)
         if (dYear === currentYear && dDate <= refDate && dDate >= new Date(currentYear, 0, 1)) {
            const b = getBucket(dDate);
            pData.curr[b] = (pData.curr[b] || 0) + val;
            yTrend.curr[dayKey] = (yTrend.curr[dayKey] || 0) + val;
         }
         comparisons.forEach(comp => {
            const compCutoff = new Date(comp.year, refDate.getMonth(), refDate.getDate());
            if (dYear === comp.year && dDate <= compCutoff && dDate >= new Date(comp.year, 0, 1)) {
               const b = getBucket(dDate);
               pData[comp.year][b] = (pData[comp.year][b] || 0) + val;
               yTrend.comp[comp.year][dayKey] = (yTrend.comp[comp.year][dayKey] || 0) + val;
            }
         });
      });

      // 4.5 Build Dynamic Target (Old = +25% YoY, New = +30% MoM)
      let tTotal = 0; let tTrend = {}; let pDataTarget = {};
      const yoyMult = 1 + (appState.targetConfig.yoy / 100);
      const momMult = 1 + (appState.targetConfig.mom / 100);

      Object.values(itemProfiles).forEach(profile => {
         if (profile.isOld) {
            // Established Product: Apply YoY to previous year's daily pacing
            Object.keys(profile.prevDaily).forEach(dayKey => {
               const tVal = profile.prevDaily[dayKey] * yoyMult;
               const [mm, dd] = dayKey.split('-');
               const dDate = new Date(currentYear, parseInt(mm)-1, parseInt(dd));
               
               tTrend[dayKey] = (tTrend[dayKey] || 0) + tVal;
               if (dDate >= startCurr && dDate <= endCurr) {
                  tTotal += tVal;
                  initMasterItem(profile.name, profile.category, profile.line);
                  appState.pMasterItems[profile.name].target += tVal;
               }
               if (dDate <= refDate && dDate >= new Date(currentYear, 0, 1)) {
                  pDataTarget[getBucket(dDate)] = (pDataTarget[getBucket(dDate)] || 0) + tVal;
               }
            });
         } else {
            // New Product: Apply MoM compound starting from 1st active month
            const firstM = profile.currMonthly.findIndex(v => v > 0);
            if (firstM !== -1) {
               let currT = profile.currMonthly[firstM];
               for (let m = firstM; m <= 11; m++) {
                  if (m > firstM) currT *= momMult;
                  const daysInM = new Date(currentYear, m + 1, 0).getDate();
                  const dailyVal = currT / daysInM; // Distribute month evenly to days

                  for (let day = 1; day <= daysInM; day++) {
                     const dDate = new Date(currentYear, m, day);
                     const dayKey = ('0' + (m+1)).slice(-2) + '-' + ('0' + day).slice(-2);
                     
                     tTrend[dayKey] = (tTrend[dayKey] || 0) + dailyVal;
                     if (dDate >= startCurr && dDate <= endCurr) {
                        tTotal += dailyVal;
                        initMasterItem(profile.name, profile.category, profile.line);
                        appState.pMasterItems[profile.name].target += dailyVal;
                     }
                     if (dDate <= refDate && dDate >= new Date(currentYear, 0, 1)) {
                        pDataTarget[getBucket(dDate)] = (pDataTarget[getBucket(dDate)] || 0) + dailyVal;
                     }
                  }
               }
            }
         }
      });

      // NEW: Proportional Target Allocation for Segments
      if (appState.pFilters.segment === 'All' && Object.keys(appState.pMasterSegments).length > 0) {
         let totCurr = 0;
         Object.values(appState.pMasterSegments).forEach(seg => totCurr += seg.curr);
         if (totCurr > 0) {
            Object.values(appState.pMasterSegments).forEach(seg => {
               seg.target = (seg.curr / totCurr) * tTotal; // Proportional baseline
            });
         }
      }

      const targetData = { active: appState.pCompareTarget, total: tTotal, trend: tTrend, pData: pDataTarget };
      appState.pYearlyTrend = yTrend;
      // Store for Modal

      // 5. Render UI
      renderCompareToggles(currentYear);
      renderDynamicKPIs(currTotal, comparisons, startCurr, endCurr, measure, targetData);
      updateProductChart(currTrend, comparisons, startCurr, endCurr, periodicBuckets, pData, currentYear, targetData, timeframe);
      updateProductList(currItems, measure);
}

