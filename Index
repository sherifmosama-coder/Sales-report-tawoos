    function getScopedData() {
        if (!appState.rawData || !Array.isArray(appState.rawData)) return [];
        if (appState.timeScope === 'FULL') return appState.rawData;

        const now = new Date();
        const currentMonth = now.getMonth() + 1; // 1-12
        const currentQuarter = Math.floor(now.getMonth() / 3) + 1; // 1-4

        return appState.rawData.filter(row => {
            if (appState.timeScope === 'YTD') return (Number(row.month) || 0) <= currentMonth;
            if (appState.timeScope === 'QTD') return (Number(row.quarter) || 0) === currentQuarter;
            if (appState.timeScope === 'MTD') return (Number(row.month) || 0) === currentMonth;
            return true;
        });
    }

