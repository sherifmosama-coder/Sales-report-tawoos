// ==========================================
// --- NEW: SUMMARY INSPECTOR HOOK ---
// Bridges the Executive Cards to the Drill-Down Modal
// ==========================================
function openSummaryInspector(product, targetMs, dateLabel, spotMs, spotLabel) {
    // Set the global product filter so the modal identifies the correct product
    appState.cFilters.product = product;

    // Find the active Cost/BOM event for this point in time
    let pHistory = appState.costingData.filter(d => d.product === product && new Date(d.date).getTime() <= targetMs);
    pHistory.sort((a,b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    let activeBomEvent = pHistory.length > 0 ? pHistory[0] : null;

    if (!activeBomEvent) {
        alert("No cost data available for this date to inspect.");
        return;
    }

    // Set the active inspection period to the exact 24-hour window of the Spot Price
    let activeSpotMs = spotMs || targetMs;
    appState.activeInspectPeriod = {
        startMs: activeSpotMs, 
        endMs: activeSpotMs + 86400000, // This is for Sales matching only
        bomEvalMs: targetMs, // NEW: Absolute strict timeline constraint for BOM (Current or Baseline)
        dateLabel: "Spot Day: " + (spotLabel || dateLabel),
        bomEvent: activeBomEvent
    };

    // Default to Sales Tab for general row clicks
    let salesTab = document.getElementById('sales-tab');
    let costsTab = document.getElementById('costs-tab');
    let salesPane = document.getElementById('sales-pane');
    let costsPane = document.getElementById('costs-pane');
    
    if (salesTab && costsTab) {
        salesTab.classList.add('active');
        costsTab.classList.remove('active');
        salesPane.classList.add('show', 'active');
        costsPane.classList.remove('show', 'active');
    }

    // Trigger the existing modal logic
    openTransactionInspector();
}

