             const val = targetId === 'current' ? d.curr : d.baseline;
             if (val > 0) { labels.push(d.name); dataPts.push(val); }
          });

          const ctx = document.getElementById('kpiPieChart').getContext('2d');
          if(kpiPieChartInstance) kpiPieChartInstance.destroy();
          kpiPieChartInstance = new Chart(ctx, {
             type: 'doughnut',
             data: {
                labels: labels,
                datasets: [{ data: dataPts, backgroundColor: ['#3b82f6','#10b981','#f59e0b','#ec4899','#8b5cf6','#64748b','#14b8a6','#f43f5e'], borderWidth: 2, borderColor: '#fff' }]
             },
             options: { 
                responsive: true, 
                maintainAspectRatio: false, 
                cutout: '55%',
                plugins: { 
                   legend: { position: 'right' },
                   tooltip: {
                      callbacks: {
                         label: function(context) {
                            let total = context.chart._metasets[context.datasetIndex].total;
                            let percent = ((context.raw / total) * 100).toFixed(1) + '%';
                            return ` ${context.label}: ${fmt(context.raw)} (${percent})`;
                         }
                      }
                   }
                } 
             },
             plugins: [{
                id: 'slicePercentages',
                afterDatasetsDraw(chart) {
                   const { ctx } = chart;
                   chart.data.datasets.forEach((dataset, i) => {
                      const meta = chart.getDatasetMeta(i);
                      let total = dataset.data.reduce((a, b) => a + b, 0);
                      meta.data.forEach((element, index) => {
                         const val = dataset.data[index];
                         const ratio = val / total;
                         // Only draw text if the slice is large enough (> 4%) to prevent messy overlaps
                         if (ratio > 0.04) {
                            const percent = (ratio * 100).toFixed(0) + '%';
                            const { x, y } = element.tooltipPosition();
                            
                            ctx.save();
                            ctx.fillStyle = '#ffffff';
                            ctx.font = 'bold 12px "Segoe UI", Roboto, Helvetica, Arial, sans-serif';
                            ctx.textAlign = 'center';
                            ctx.textBaseline = 'middle';
                            // Add a subtle drop shadow to make the white text pop on light colors
                            ctx.shadowColor = 'rgba(0,0,0,0.4)';
                            ctx.shadowBlur = 4;
                            
                            ctx.fillText(percent, x, y);
                            ctx.restore();
                         }
                      });
                   });
                }
             }]
          });

       } else {
          // Growth Table
          document.getElementById('kpiModalPieContainer').style.display = 'none';
          document.getElementById('kpiModalTableContainer').style.display = 'block';
          document.getElementById('kpiTableBaseHeader').innerText = targetId === 'target' ? 'Target' : targetId;
          
          let tableHtml = '';
          sortedArr.forEach(d => {
             if (d.curr === 0 && d.baseline === 0) return;
             const growth = d.baseline > 0 ? ((d.curr - d.baseline) / d.baseline) * 100 : 0;
             const gColor = growth >= 0 ? 'text-success' : 'text-danger';
             
             tableHtml += `
                <tr>
                   <td class="fw-bold text-dark ps-3 py-3">${d.name}</td>
                   <td class="text-end fw-bold text-primary">${fmt(d.curr)}</td>
                   <td class="text-end text-muted">${fmt(d.baseline)}</td>
                   <td class="text-end pe-3 fw-bold ${gColor}">${growth >= 0 ? '+' : ''}${growth.toFixed(1)}%</td>
                </tr>`;
          });
          document.getElementById('kpiModalTableBody').innerHTML = tableHtml || `<tr><td colspan="4" class="text-center py-4 text-muted">No data available for this breakdown.</td></tr>`;
       }
    }
