// --- NEW: DIRECT BOM INSPECTOR HOOK ---
// Opens the Drill-Down Modal directly to the BOM tab
// ==========================================
function openBomTab(event, product, targetMs, dateLabel, spotMs, spotLabel) {
    // Stop the row click from firing so we don't trigger the modal twice
    if (event) event.stopPropagation();
    
    openSummaryInspector(product, targetMs, dateLabel, spotMs, spotLabel);
    
    // Override default tab switch to instantly reveal the Costs (BOM) tab
    let salesTab = document.getElementById('sales-tab');
    let costsTab = document.getElementById('costs-tab');
    let salesPane = document.getElementById('sales-pane');
    let costsPane = document.getElementById('costs-pane');
    
    if (salesTab && costsTab) {
        salesTab.classList.remove('active');
        costsTab.classList.add('active');
        salesPane.classList.remove('show', 'active');
        costsPane.classList.add('show', 'active');
    }
}

