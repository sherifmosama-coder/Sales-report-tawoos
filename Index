function toggleExecutiveView() {
    appState.execState.isSummary = !appState.execState.isSummary;
    let isExec = appState.execState.isSummary;
    
    document.getElementById('detailed-step2').classList.toggle('d-none', isExec);
    document.getElementById('detailed-charts').classList.toggle('d-none', isExec);
    document.getElementById('executive-summary-view').classList.toggle('d-none', !isExec);
    
    // --- NEW: DYNAMIC BUTTON UI (MOBILE SCALED) ---
    let btn = document.getElementById('btn-exec-toggle');
    if (btn) {
        if (isExec) {
            btn.className = "btn btn-outline-dark rounded-pill px-4 py-2 fw-bold shadow-sm border-2 border-dark";
            btn.innerHTML = `<i class="fas fa-chart-area me-2 text-primary" style="font-size: 1.2rem;"></i><span style="font-size: 1rem;">Detailed View</span>`;
        } else {
            btn.className = "btn btn-dark rounded-pill px-4 py-2 fw-bold shadow-sm border-2 border-dark";
            btn.innerHTML = `<i class="fas fa-mobile-alt me-2 text-warning" style="font-size: 1.2rem;"></i><span style="font-size: 1rem;">Executive Summary</span>`;
        }
    }
    
    if (isExec) renderExecutiveSummary();
}

function toggleExecCompare() {
    appState.execState.isCompare = document.getElementById('execCompareToggle').checked;
    let dateSelector = document.getElementById('execDateSelector');
    
    if (appState.execState.isCompare) {
        dateSelector.classList.remove('d-none');
        dateSelector.classList.add('d-flex');
    } else {
        dateSelector.classList.add('d-none');
        dateSelector.classList.remove('d-flex');
    }
    renderExecutiveSummary();
}

function renderExecutiveSummary() {
    const container = document.getElementById('executive-cards-container');
    if (!container) return;

    let selectedCat = appState.cFilters.category;
    let allProducts = [...new Set(appState.costingData.map(d => d.product))];
    let groups = {};

    // --- NEW: CATEGORY GROUPING LOGIC ---
    if (selectedCat !== 'All') {
        groups[selectedCat] = allProducts.filter(p => {
            let pd = appState.costingData.find(d => d.product === p);
            return pd && pd.category === selectedCat;
        });
    } else {
        allProducts.forEach(p => {
            let pd = appState.costingData.find(d => d.product === p);
            let cat = pd ? pd.category : 'Uncategorized';
            if (!groups[cat]) groups[cat] = [];
            if (!groups[cat].includes(p)) groups[cat].push(p);
        });
    }

    let html = '';
    const fmt = new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const nowMs = Date.now();
    const baseMs = new Date(document.getElementById('execBaseDate').value).getTime();

    // --- NEW: DYNAMIC GLOBAL MATERIAL LEDGER ---
    const getGlobalMaterialsAt = (targetMs) => {
        let ledger = {};
        appState.costingData.forEach(d => {
            let eventMs = new Date(d.date).getTime();
            if (eventMs <= targetMs && d.bomMeta) {
                Object.keys(d.bomMeta).forEach(mat => {
                    if (mat === '_isVatExempt') return;
                    let meta = d.bomMeta[mat];
                    if (!ledger[mat]) ledger[mat] = { actDateMs: 0, actRate: 0, mktDateMs: 0, mktRate: 0, actBaseRate: 0, actVatRate: 0 };
                    if (meta.actDateMs && meta.actDateMs <= targetMs) {
                        if (meta.actDateMs > ledger[mat].actDateMs || (meta.actDateMs === ledger[mat].actDateMs && meta.actBaseRate > 0)) { 
                            ledger[mat].actDateMs = meta.actDateMs; ledger[mat].actRate = meta.actRate; 
                            if (meta.actBaseRate > 0) { ledger[mat].actBaseRate = meta.actBaseRate; ledger[mat].actVatRate = meta.actVatRate; }
                        }
                    }
                    if (meta.mktRate > 0 && meta.mktDateMs && meta.mktDateMs <= targetMs) {
                        if (meta.mktDateMs > ledger[mat].mktDateMs) { ledger[mat].mktDateMs = meta.mktDateMs; ledger[mat].mktRate = meta.mktRate; }
                    }
                });
            }
        });
        return ledger;
    };
    const globalCurrMaterials = getGlobalMaterialsAt(nowMs);
    const globalBaseMaterials = appState.execState.isCompare ? getGlobalMaterialsAt(baseMs) : {};

    // Iterate through each Category Group
    Object.keys(groups).sort().forEach(cat => {
        let products = groups[cat].sort();
        if (products.length === 0) return;

        // If 'All' is selected, print the Category Header
        if (selectedCat === 'All') {
            html += `<h4 class="mt-4 mb-3 pb-2 border-bottom border-2 fw-bold text-dark"><i class="fas fa-layer-group me-2 text-primary"></i>${cat}</h4>`;
        }

        products.forEach(p => {
            const getStatsAt = (targetMs) => {
                let pData = appState.costingData.filter(d => d.product === p && new Date(d.date).getTime() <= targetMs);
                pData.sort((a,b) => new Date(b.date).getTime() - new Date(a.date).getTime());
                let activeEntry = pData.length > 0 ? pData[0] : null;

                // --- NEW: HYBRID CHRONOLOGICAL COST LOGIC (GLOBAL KNOWLEDGE) ---
                let cost = 0;
                let globalLedger = (targetMs === baseMs) ? globalBaseMaterials : globalCurrMaterials;

                if (activeEntry && activeEntry.bomMeta) {
                    Object.keys(activeEntry.bomMeta).forEach(mat => {
                        if (mat === '_isVatExempt') return;
                        let localMeta = activeEntry.bomMeta[mat];
                        let gMeta = globalLedger[mat] || localMeta;
                        
                        let actMs = gMeta.actDateMs || 0;
                        let mktMs = gMeta.mktDateMs || 0;
                        
                        // DYNAMIC VAT ROUTING
                        let isVatExempt = activeEntry.bomMeta._isVatExempt;
                        let resolvedActRate = gMeta.actRate;
                        if (gMeta.actBaseRate > 0) { resolvedActRate = isVatExempt ? gMeta.actVatRate : gMeta.actBaseRate; }
                        
                        let rate = (mktMs > actMs) ? gMeta.mktRate : resolvedActRate;
                        
                        // Extract original recipe qty using the local snapshot rates
                        let actCost = activeEntry.bomActual ? (activeEntry.bomActual[mat] || 0) : 0;
                        let mktCost = activeEntry.bomMarket ? (activeEntry.bomMarket[mat] || 0) : 0;
                        let qtyUsed = (localMeta.actRate > 0 && actCost > 0) ? (actCost / localMeta.actRate) : ((localMeta.mktRate > 0 && mktCost > 0) ? (mktCost / localMeta.mktRate) : 0);
                        
                        cost += (qtyUsed * rate);
                    });
                } else if (activeEntry) {
                    cost = activeEntry.unitActual || 0; // Fallback
                }

                // --- NEW: SINGLE-DAY SPOT PRICING LOGIC ---
                let historicalSales = (appState.netSalesData || []).filter(s => s.product === p && s.dateMs <= targetMs);
                
                let gAsp = 0, nAsp = 0, profAmt = 0, profPct = 0;
                let spotMs = targetMs;
                let spotLabel = "No Sales Found";
                
                if (historicalSales.length > 0) {
                    // Sort descending to find the absolute most recent sale date
                    historicalSales.sort((a, b) => b.dateMs - a.dateMs);
                    let targetDateString = historicalSales[0].date; 
                    spotMs = historicalSales[0].dateMs;
                    spotLabel = new Date(spotMs).toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'});
                    
                    // Isolate ONLY the sales that happened on that exact single calendar day
                    let spotSales = historicalSales.filter(s => s.date === targetDateString);
                    
                    let gRev = 0, nRev = 0, qty = 0;
                    spotSales.forEach(s => { gRev += s.grossRev; nRev += s.netRev; qty += s.qty; });

                    gAsp = qty > 0 ? gRev / qty : 0;
                    nAsp = qty > 0 ? nRev / qty : 0;
                }
                
                profAmt = nAsp > 0 ? nAsp - cost : 0;
                profPct = nAsp > 0 ? (profAmt / nAsp) * 100 : 0;

                return { cost, gAsp, nAsp, profAmt, profPct, spotMs, spotLabel };
            };

            let currStats = getStatsAt(nowMs);
            let currDateStr = new Date().toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'});

            let baseStats = appState.execState.isCompare ? getStatsAt(baseMs) : null;
            let baseDateStr = appState.execState.isCompare ? new Date(baseMs).toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'}) : '';

            let compareSummaryHtml = '';
            if (appState.execState.isCompare && baseStats) {
                const calcPct = (curr, base) => base === 0 ? (curr > 0 ? 100 : 0) : ((curr - base) / Math.abs(base)) * 100;
                
                // Helper to build smart financial badges (Subtle Theme)
                const getBadge = (pct, isCost) => {
                    if (Math.abs(pct) < 0.1) return { theme: 'secondary', icon: 'fa-minus', text: 'Stable' };
                    let isUp = pct > 0;
                    // Financial logic: Cost going up is Bad (danger), Profit/ASP going up is Good (success)
                    let theme = isUp ? (isCost ? 'danger' : 'success') : (isCost ? 'success' : 'danger');
                    let icon = isUp ? 'fa-arrow-up' : 'fa-arrow-down';
                    return { theme, icon, text: Math.abs(pct).toFixed(1) + '%' };
                };

                let cB = getBadge(calcPct(currStats.cost, baseStats.cost), true);
                let aB = getBadge(calcPct(currStats.nAsp, baseStats.nAsp), false);
                let pB = getBadge(calcPct(currStats.profAmt, baseStats.profAmt), false);

                compareSummaryHtml = `
                    <div class="mt-3 d-flex justify-content-between align-items-center w-100 gap-2">
                        <span class="badge rounded-pill bg-${cB.theme} bg-opacity-10 text-${cB.theme} border border-${cB.theme} py-2 px-3 shadow-sm flex-fill text-center" style="font-size: 0.85rem;">
                            <i class="fas ${cB.icon} me-2"></i>Cost: ${cB.text}
                        </span>
                        <span class="badge rounded-pill bg-${aB.theme} bg-opacity-10 text-${aB.theme} border border-${aB.theme} py-2 px-3 shadow-sm flex-fill text-center" style="font-size: 0.85rem;">
                            <i class="fas ${aB.icon} me-2"></i>Net ASP: ${aB.text}
                        </span>
                        <span class="badge rounded-pill bg-${pB.theme} bg-opacity-10 text-${pB.theme} border border-${pB.theme} py-2 px-3 shadow-sm flex-fill text-center" style="font-size: 0.85rem;">
                            <i class="fas ${pB.icon} me-2"></i>Profit: ${pB.text}
                        </span>
                    </div>
                `;
            }

            // Notice: We pass the exact Spot Date into openSummaryInspector so the Sales ledger aligns perfectly with the day the ASP was derived.
            // Add robust py-3 padding to turn rows into fat, highly clickable mobile zones.
            let rowHtml = `
                <tr onclick="openSummaryInspector('${p.replace(/'/g, "\\'")}', ${nowMs}, '${currDateStr}', ${currStats.spotMs}, '${currStats.spotLabel}')" style="cursor: pointer;" title="Click to inspect lineage">
                    <td class="fw-bold text-dark text-nowrap ps-4 py-3">${currDateStr} <span class="badge bg-primary ms-1" style="font-size:0.5rem;">CURRENT</span></td>
                    <td class="text-danger fw-bold text-nowrap py-3">
                        ${fmt.format(currStats.cost)} EGP 
                        <span class="d-print-none ms-3 bg-light border border-secondary rounded px-3 py-2 shadow-sm" style="cursor: pointer; display: inline-block;" title="Inspect Detailed BOM" onclick="openBomTab(event, '${p.replace(/'/g, "\\'")}', ${nowMs}, '${currDateStr}', ${currStats.spotMs}, '${currStats.spotLabel}')">
                            <i class="fas fa-search-plus text-primary fs-6"></i>
                        </span>
                    </td>
                    <td class="text-muted text-nowrap py-3" style="text-decoration: line-through;" title="Derived from spot sales on ${currStats.spotLabel}">${currStats.gAsp > 0 ? fmt.format(currStats.gAsp) : '--'}</td>
