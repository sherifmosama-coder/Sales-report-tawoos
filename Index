<script>
    // --- COLORS ---
    const COLORS = {
      'All Years': '#1e293b', '2026': '#dc3545', '2025': '#198754', '2024': '#0d6efd', '2023': '#6f42c1', '2022': '#fd7e14', '2021': '#6c757d',
      'جملة': '#f59e0b', 'تجزئة': '#0ea5e9', 'سلاسل': '#3b82f6', 'مطعم': '#ef4444', 'اون لاين': '#8b5cf6', 'All Types': '#1e293b'
    };
    function getColor(k) { return COLORS[k] || (k.includes('جملة')?COLORS['جملة']:k.includes('تجزئة')?COLORS['تجزئة']:k.includes('مطعم')?COLORS['مطعم']:'#94a3b8'); }

    // --- STATE ---
    // Segment Icon Mapping
    const segmentIcons = {
      "تجزئة": "fa-store",
      "جملة": "fa-boxes-stacked",
      "مطعم": "fa-utensils",
      "سلاسل": "fa-building",
      "سرجة / عطارة": "fa-mortar-pestle",
      "اون لاين": "fa-globe",
      "اخرين": "fa-layer-group"
    };

    function getSegmentHTML(type) {
      const icon = segmentIcons[type] || "fa-tag";
      return `<span class="badge bg-light text-dark border"><i class="fas ${icon} me-1 text-primary"></i> ${type}</span>`;
    }

    let appState = {
      mode: 'client', // 'client' or 'product'
      rawData: [],
      productData: [],
      selectedYear: 'All',
      selectedType: 'All',
      viewMode: 'qty',
      pFilters: { segment: 'All', category: 'All', line: 'All', item: 'All' },
      pChart: null,
      sortBy: 'qty',
      groupBy: 'None',
      chartInstance: null,
      modalChartInstance: null,
      pCompareYears: [], // Dynamic array of selected past years
      pChartViewMode: 'detailed', // Default view
      pYearlyTrend: null, // Holds data for the Drill Down
      pCompareTarget: false, // Target Toggle
      targetConfig: { yoy: 25, mom: 30 },
      pMasterItems: {}, 
      kpiModalState: { type: 'value', targetId: 'current', viewLevel: 'category' },
      
      // NEW: Costing Engine State
      costingData: [],
      cFilters: { category: 'WHITE T', product: 'خل الطاووس ( 900 مللي )', view: 'actual', timeline: 'monthly' },
      cDoughnutChart: null,
      cChartInstance: null,
      bomChartInstance: null
    };

    function toggleCompareTarget() {
       appState.pCompareTarget = !appState.pCompareTarget;
       renderProductDashboard();
    }

    function openTargetConfig() {
       document.getElementById('conf-yoy').value = appState.targetConfig.yoy;
       document.getElementById('conf-mom').value = appState.targetConfig.mom;
       new bootstrap.Modal(document.getElementById('targetConfigModal')).show();
    }

    function saveTargetConfig() {
       appState.targetConfig.yoy = parseFloat(document.getElementById('conf-yoy').value) || 0;
       appState.targetConfig.mom = parseFloat(document.getElementById('conf-mom').value) || 0;
       document.getElementById('target-note-text').innerText = `Target: +${appState.targetConfig.yoy}% YoY (Established) | +${appState.targetConfig.mom}% MoM (New)`;
       bootstrap.Modal.getInstance(document.getElementById('targetConfigModal')).hide();
       renderProductDashboard();
    }

    function setChartViewMode(mode) {
       appState.pChartViewMode = mode;
       renderProductDashboard();
    }

function toggleCompareYear(year) {
       const idx = appState.pCompareYears.indexOf(year);
       if (idx > -1) {
          if (appState.pCompareYears.length > 1) appState.pCompareYears.splice(idx, 1); // Always keep at least 1 selected
       } else {
          appState.pCompareYears.push(year);
       }
       appState.pCompareYears.sort((a, b) => b - a); // Sort descending
       renderProductDashboard();
    }
    
    // No auto-init. Wait for user selection.
    window.onload = function() {
       console.log("App Loaded. Waiting for source selection...");
       // FIX: Hide the loader so the Landing Screen is visible
       document.getElementById('smart-loader').style.display = 'none';
    };

    let loaderInterval;
    let progressInterval;
    let syncInterval;
    
    function switchModule(mode) {
       if (mode === appState.mode) return;
       appState.mode = mode;
       
       // 1. Update the Floating Navigator UI
       document.getElementById('nav-btn-client').className = mode === 'client' ? 'nav-btn active' : 'nav-btn';
       document.getElementById('nav-btn-product').className = mode === 'product' ? 'nav-btn active' : 'nav-btn';
       document.getElementById('nav-btn-costing').className = mode === 'costing' ? 'nav-btn active' : 'nav-btn';

       // 2. Force Hide ALL containers safely
       document.getElementById('client-view-container').style.display = 'none';
       document.getElementById('product-controls').style.display = 'none';
       document.getElementById('product-content-area').style.display = 'none';
       document.getElementById('costing-view-container').style.display = 'none';

       // 3. Route to the correct view (or trigger Loader if data is missing)
       if (mode === 'product') {
          if (appState.productData.length === 0) { loadSource('product'); } 
          else { initProductView(); }
       } else if (mode === 'costing') {
          if (appState.costingData.length === 0) { loadSource('costing'); } 
          else { initCostingView(); }
       } else {
          if (appState.rawData.length === 0) { loadSource('client'); } 
          else { initClientView(); }
       }
    }

    function loadSource(mode) {
      document.getElementById('landing-screen').style.display = 'none';
      document.getElementById('main-dashboard').style.display = 'none';
      document.getElementById('floating-navigator').style.display = 'none';
      appState.mode = mode;

      const loader = document.getElementById('smart-loader');
      const icon = document.getElementById('loader-icon');
      const title = document.getElementById('loader-title');
      const insightEl = document.getElementById('loader-insight');
      
      let insights = [];
      if (mode === 'client') {
         icon.className = 'fas fa-users-viewfinder text-primary';
         document.getElementById('loader-icon-box').style.color = '#3b82f6';
         title.innerText = "Clients' Sales across Years";
         insights = ["Mapping client Orders...", "Analyzing longitudinal order frequencies...", "Calculating risk of losing clients...", "Rendering client behavior segments..."];
      } else if (mode === 'product') {
         icon.className = 'fas fa-chart-line text-success';
         document.getElementById('loader-icon-box').style.color = '#10b981';
         title.innerText = "SKUs Analytics across Years";
         insights = ["Aggregating SKU-level transaction volumes...", "Reconciling historical comparison periods...", "Projecting dynamic baseline targets...", "Compiling periodic trend horizons..."];
      } else if (mode === 'costing') {
         icon.className = 'fas fa-industry text-danger';
         document.getElementById('loader-icon-box').style.color = '#ef4444';
         title.innerText = "Production Costing Analysis";
         insights = ["Syncing Two-Tier FIFO Engine...", "Resolving Bill of Materials...", "Calculating Actual vs Market Discrepancies...", "Rendering Unit Costs..."];
      }

      loader.style.display = 'flex';
      
      let progress = 0;
      const loaderBar = document.getElementById('loader-progress-bar');
      loaderBar.style.width = '0%';
      clearInterval(progressInterval);
      
      progressInterval = setInterval(() => {
         progress += 0.475;
         if (progress > 95) progress = 95;
         loaderBar.style.width = progress + '%';
      }, 100);

      let insightIdx = 0;
      insightEl.innerText = insights[0];
      clearInterval(loaderInterval);
      loaderInterval = setInterval(() => {
         insightEl.classList.remove('active');
         setTimeout(() => {
            insightIdx = (insightIdx + 1) % insights.length;
            insightEl.innerText = insights[insightIdx];
            insightEl.classList.add('active');
         }, 400); 
      }, 2500);

      // --- CRITICAL ROUTING LOGIC ---
      let backendFn = 'getDashboardData';
      if (mode === 'product') backendFn = 'getProductData';
      if (mode === 'costing') backendFn = 'getCostingData';

      google.script.run
        .withSuccessHandler(response => {
          
          // HELPER: Executes the final UI transition after data is ready
          const finishLoad = (modeToInit) => {
             clearInterval(loaderInterval); 
             clearInterval(progressInterval); 
             document.getElementById('loader-progress-bar').style.width = '100%';
             setTimeout(() => {
                document.getElementById('smart-loader').style.display = 'none';
                document.getElementById('floating-navigator').style.display = 'flex';
                document.getElementById('nav-btn-client').className = modeToInit === 'client' ? 'nav-btn active' : 'nav-btn';
                document.getElementById('nav-btn-product').className = modeToInit === 'product' ? 'nav-btn active' : 'nav-btn';
                document.getElementById('nav-btn-costing').className = modeToInit === 'costing' ? 'nav-btn active' : 'nav-btn';
                
                if (modeToInit === 'product') {
                   document.getElementById('report-date').valueAsDate = new Date();
                   initProductView();
                } else if (modeToInit === 'costing') {
                   initCostingView();
                } else {
                   initClientView();
                }
             }, 300);
          };

          if (!response) { alert("System Alert: Unable to retrieve dataset."); return; }

          if (mode === 'product') {
             try {
                const archive = JSON.parse(response.archiveString || "[]");
                appState.productData = archive.concat(response.liveData || []);
             } catch(e) { appState.productData = response.liveData || []; }
             finishLoad('product');
          } else if (mode === 'client') {
             if (!Array.isArray(response)) { alert("System Alert: Dataset error."); return; }
             appState.rawData = response;
             finishLoad('client');
          } else if (mode === 'costing') {
             if (response.error) { alert("Cost Engine Error: " + response.error); return; }
             appState.costingData = response;
             
             // CROSS-REFERENCE CHECK: Ensure Product Data is loaded for ASP math
             if (!appState.productData || appState.productData.length === 0) {
                 document.getElementById('loader-insight').innerText = "Cross-referencing sales ledger...";
                 google.script.run.withSuccessHandler(prodRes => {
                     try {
                        const archive = JSON.parse(prodRes.archiveString || "[]");
                        appState.productData = archive.concat(prodRes.liveData || []);
                     } catch(e) { appState.productData = prodRes.liveData || []; }
                     finishLoad('costing');
                 }).getProductData();
             } else {
                 finishLoad('costing');
             }
          }
        })
        .withFailureHandler(error => {
            alert("Server Error: " + error.message);
            document.getElementById('smart-loader').style.display = 'none';
            document.getElementById('landing-screen').style.display = 'block';
        })[backendFn]();
    }

    function initClientView() {
       document.getElementById('main-dashboard').style.display = 'block';
       
       // Show Client Container
       document.getElementById('client-view-container').style.display = 'block';
       
       // Hide Product & Costing Containers
       document.getElementById('product-controls').style.display = 'none';
       document.getElementById('product-content-area').style.display = 'none';
       document.getElementById('costing-view-container').style.display = 'none'; // NEW: Hide Costing

       renderDashboard(); 
    }

    function initProductView() {
       document.getElementById('main-dashboard').style.display = 'block';
       
       // Hide Client & Costing Containers
       document.getElementById('client-view-container').style.display = 'none';
