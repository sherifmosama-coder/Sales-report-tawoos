    function renderCostingDashboard() {
       // --- NEW: DYNAMIC HEADER & DESCRIPTION ENGINE ---
       const currentView = appState.cFilters.view;
       const currentProduct = appState.cFilters.product;
       let stateTitle = "";
       let stateDesc = "";
       let stateIcon = "";

       if (currentView === 'actual') {
          stateTitle = "Actual Cost Analysis";
          stateIcon = "fa-file-invoice-dollar text-primary";
          stateDesc = "Calculated using the latest verified acquisition prices from the Purchases ledger. This represents the current real-time replacement cost of the product's Bill of Materials.";
       } else if (currentView === 'market') {
          stateTitle = "Market (Indicative) Projections";
          stateIcon = "fa-bolt-lightning text-danger";
          stateDesc = "Reflects indicative price overrides entered manually to anticipate upcoming market shifts. This allows for margin forecasting before new purchase prices are officially realized.";
       } else {
          stateTitle = "Comparative Variance Analysis";
          stateIcon = "fa-code-compare text-warning";
          stateDesc = "A dual-layered reconciliation of verified actuals against manual market projections. This view isolates cost variance and highlights potential margin exposure from upcoming volatility.";
       }

       document.getElementById('costing-chart-header').innerHTML = `
          <div class="d-flex justify-content-between align-items-start border-bottom pb-3">
             <div class="flex-grow-1">
                <h4 class="fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">${currentProduct}</h4>
                <div class="d-flex align-items-center">
                   <span class="badge bg-light text-dark border rounded-pill px-3 py-1" style="font-size: 0.7rem;">
                      <i class="fas ${stateIcon} me-2"></i>${stateTitle}
                   </span>
                </div>
             </div>
             <div class="ms-4 text-end d-none d-md-block" style="max-width: 450px;">
                <p class="text-muted mb-0 fw-medium" style="font-size: 0.8rem; line-height: 1.5; font-style: italic;">
                   "${stateDesc}"
                </p>
             </div>
          </div>
       `;

       // 1. IDENTIFY VOLATILE MATERIALS & BUILD SCORECARDS
       const alertMats = new Set((appState.globalAlerts || []).map(a => a.mat));
       
       // --- NEW: HANDLE "ALL" CATEGORY FOR PRODUCTS ---
       let catData = appState.cFilters.category === 'All' ? 
                     appState.costingData : 
                     appState.costingData.filter(d => d.category === appState.cFilters.category);
                     
       const catProducts = [...new Set(catData.map(d => d.product))].sort();
       
       if (!catProducts.includes(appState.cFilters.product)) {
           appState.cFilters.product = catProducts.includes('خل الطاووس ( 900 مللي )') ? 'خل الطاووس ( 900 مللي )' : (catProducts.length > 0 ? catProducts[0] : 'All');
       }
       
       let scorecardHtml = '';
       catProducts.forEach(p => {
           const pHistory = appState.costingData.filter(d => d.product === p).sort((a,b) => new Date(b.date) - new Date(a.date));
           const latestEntry = pHistory[0] || {};
           
           // --- NEW: HYBRID CHRONOLOGICAL COST WITH GLOBAL LEDGER FOR DETAILED SCORECARDS ---
           let evalMs = Date.now(); // Detailed view always looks at 'Today'
           let globalLedger = {};
           appState.costingData.forEach(d => {
                let eventMs = new Date(d.date).getTime();
                if (eventMs <= evalMs && d.bomMeta) {
                    Object.keys(d.bomMeta).forEach(m => {
                        if (m === '_isVatExempt') return;
                        let meta = d.bomMeta[m];
                        if (!globalLedger[m]) globalLedger[m] = { actDateMs: 0, actRate: 0, mktDateMs: 0, mktRate: 0, actBaseRate: 0, actVatRate: 0 };
                        if (meta.actDateMs && meta.actDateMs <= evalMs) {
                            // Ensure we capture the dual rates if available
                            if (meta.actDateMs > globalLedger[m].actDateMs || (meta.actDateMs === globalLedger[m].actDateMs && meta.actBaseRate > 0)) { 
                                globalLedger[m].actDateMs = meta.actDateMs; globalLedger[m].actRate = meta.actRate; 
                                if (meta.actBaseRate > 0) { globalLedger[m].actBaseRate = meta.actBaseRate; globalLedger[m].actVatRate = meta.actVatRate; }
                            }
                        }
                        if (meta.mktRate > 0 && meta.mktDateMs && meta.mktDateMs <= evalMs) {
                            if (meta.mktDateMs > globalLedger[m].mktDateMs) { globalLedger[m].mktDateMs = meta.mktDateMs; globalLedger[m].mktRate = meta.mktRate; }
                        }
                    });
                }
           });
           
           let displayCost = 0;
           if (latestEntry.bomMeta) {
               Object.keys(latestEntry.bomMeta).forEach(mat => {
                   if (mat === '_isVatExempt') return;
                   let localMeta = latestEntry.bomMeta[mat];
                   let gMeta = globalLedger[mat] || localMeta;
                   
                   let actMs = gMeta.actDateMs || 0;
                   let mktMs = gMeta.mktDateMs || 0;
                   
                   // DYNAMIC VAT ROUTING: Resolve the correct base vs VAT rate
                   let isVatExempt = latestEntry.bomMeta._isVatExempt;
                   let resolvedActRate = gMeta.actRate; // Fallback to old cache
                   if (gMeta.actBaseRate > 0) { resolvedActRate = isVatExempt ? gMeta.actVatRate : gMeta.actBaseRate; }
                   
                   let rate = (mktMs > actMs) ? gMeta.mktRate : resolvedActRate;
                   
                   let actCost = latestEntry.bomActual ? (latestEntry.bomActual[mat] || 0) : 0;
                   let mktCost = latestEntry.bomMarket ? (latestEntry.bomMarket[mat] || 0) : 0;
                   let qtyUsed = (localMeta.actRate > 0 && actCost > 0) ? (actCost / localMeta.actRate) : ((localMeta.mktRate > 0 && mktCost > 0) ? (mktCost / localMeta.mktRate) : 0);
                   
                   displayCost += (qtyUsed * rate);
               });
           } else {
               displayCost = latestEntry.unitActual || 0; // Fallback
           }
           
           // --- NEW: SINGLE-DAY SPOT PRICING FOR DETAILED SCORECARDS ---
           let historicalSales = (appState.netSalesData || []).filter(s => s.product === p && s.dateMs <= Date.now());
           let grossAsp = 0, netAsp = 0, spotLabel = "No Sales";
           
           if (historicalSales.length > 0) {
               // Sort descending to find the most recent active sales day
               historicalSales.sort((a, b) => b.dateMs - a.dateMs);
               let targetDateString = historicalSales[0].date;
               spotLabel = new Date(historicalSales[0].dateMs).toLocaleDateString('en-GB', {day:'numeric', month:'short'});
               
               // Isolate ONLY the sales from that specific day
               let spotSales = historicalSales.filter(s => s.date === targetDateString);
               
               let gRev = 0, nRev = 0, qty = 0;
               spotSales.forEach(s => { gRev += s.grossRev; nRev += s.netRev; qty += s.qty; });
               
               grossAsp = qty > 0 ? (gRev / qty) : 0;
               netAsp = qty > 0 ? (nRev / qty) : 0;
           }
           
           const gpVal = netAsp > 0 ? netAsp - displayCost : 0; // True Profit Margin
           const gpPct = netAsp > 0 ? ((gpVal / netAsp) * 100).toFixed(1) : 0;

           let needsAttention = false;
           if (latestEntry.bomMeta) {
               needsAttention = Object.keys(latestEntry.bomMeta).some(m => alertMats.has(m));
           }

           const isActive = appState.cFilters.product === p ? 'active' : '';
           const alertClass = needsAttention ? 'needs-attention alert-pulse' : '';
           const gpColor = gpVal >= 0 ? 'text-success' : 'text-danger';

           scorecardHtml += `
           <div class="product-card rounded-3 p-2 m-1 d-inline-block shadow-sm ${isActive} ${alertClass}" 
                onclick="updateCostingState('product', '${p.replace(/'/g, "\\'")}')" 
                style="width: 240px; vertical-align: top;">
              <div class="d-flex justify-content-between align-items-start mb-1">
                 <span class="fw-bold text-dark text-truncate" style="font-size:0.75rem; max-width:190px;">${p}</span>
                 ${needsAttention ? '<i class="fas fa-exclamation-circle text-danger" style="font-size:0.7rem;"></i>' : ''}
              </div>
              <div class="row g-0 mt-2 border-top pt-2">
                 <div class="col-3 border-end pe-1">
                    <div class="text-muted" style="font-size:0.5rem; font-weight:800;">COST</div>
                    <div class="fw-bold text-primary" style="font-size:0.7rem;">${displayCost.toFixed(1)}</div>
                 </div>
                 <div class="col-3 border-end ps-1 pe-1 text-center">
                    <div class="text-muted" style="font-size:0.5rem; font-weight:800;" title="Spot Date: ${spotLabel}">G.ASP</div>
                    <div class="fw-bold text-secondary" style="font-size:0.7rem; text-decoration: line-through;" title="Spot Date: ${spotLabel}">${grossAsp > 0 ? grossAsp.toFixed(1) : '--'}</div>
                 </div>
                 <div class="col-3 border-end ps-1 pe-1 text-center">
                    <div class="text-muted" style="font-size:0.5rem; font-weight:800;" title="Spot Date: ${spotLabel}">N.ASP</div>
                    <div class="fw-bold text-dark" style="font-size:0.7rem;" title="Spot Date: ${spotLabel}">${netAsp > 0 ? netAsp.toFixed(1) : '--'}</div>
                 </div>
                 <div class="col-3 ps-1 text-end">
                    <div class="text-muted" style="font-size:0.5rem; font-weight:800;" title="Net Gross Margin">N.GP%</div>
                    <div class="fw-bold ${gpColor}" style="font-size:0.7rem;">${gpPct}%</div>
                 </div>
              </div>
           </div>`;
       });
       
       document.getElementById('costing-product-toggles').innerHTML = scorecardHtml;

       // 2. Isolate COST SHIFT EVENTS
       const rawCostData = appState.costingData.filter(d => d.product === appState.cFilters.product);
       const chronoCostData = [...rawCostData].sort((a, b) => new Date(a.date) - new Date(b.date));
       
       let changeEvents = [];
       let lastActual = null;
       let lastMarket = null;
       for (let i = 0; i < chronoCostData.length; i++) {
          let d = chronoCostData[i];
          if (i === 0 || d.unitActual !== lastActual || d.unitMarket !== lastMarket) {
             changeEvents.push(d);
             lastActual = d.unitActual; lastMarket = d.unitMarket;
          }
       }

       // =================================================================
       // --- NEW: CALENDAR TIME-SERIES AGGREGATION ---
       // Maps the X-Axis strictly to the selected Timeline (Daily/Weekly/Monthly)
       // =================================================================
       let timeline = appState.cFilters.timeline || 'monthly';
       let filterYear = appState.cFilters.year || new Date().getFullYear().toString();
       let productSales = (appState.netSalesData || []).filter(s => s.product === appState.cFilters.product);

       let allDatesMs = [...changeEvents.map(ev => new Date(ev.date).getTime()), ...productSales.map(s => s.dateMs)];
       if (allDatesMs.length === 0) return; 

       let minMs = Math.min(...allDatesMs);
       let maxMs = Math.max(Date.now(), ...allDatesMs);

       // --- NEW: YEAR FILTER BOUNDARY CLIPPING ---
       if (filterYear !== 'All') {
           let yrInt = parseInt(filterYear);
           let startOfYearMs = new Date(yrInt, 0, 1).getTime();
           let endOfYearMs = new Date(yrInt, 11, 31, 23, 59, 59, 999).getTime();
           
           minMs = startOfYearMs;
           // If current year, stop at today to prevent trailing blank months. Otherwise, show full year.
           maxMs = (yrInt === new Date().getFullYear()) ? Date.now() : endOfYearMs;
       }

       let bins = [];
       let curr = new Date(minMs);
       curr.setHours(0,0,0,0);

       // 1. Generate Calendar Bins based on UI Toggle
       if (timeline === 'monthly') {
           curr.setDate(1); // Start of month
           while(curr.getTime() <= maxMs) {
               let startMs = curr.getTime();
               let next = new Date(curr);
               next.setMonth(next.getMonth() + 1);
               bins.push({ label: curr.toLocaleDateString('en-GB', {month: 'short', year: 'numeric'}), startMs: startMs, endMs: next.getTime() });
               curr = next;
           }
       } else if (timeline === 'weekly') {
           curr.setDate(curr.getDate() - curr.getDay()); // Start of week (Sunday)
           while(curr.getTime() <= maxMs) {
               let startMs = curr.getTime();
               let next = new Date(curr);
               next.setDate(next.getDate() + 7);
               bins.push({ label: 'Wk ' + curr.toLocaleDateString('en-GB', {day: 'numeric', month: 'short'}), startMs: startMs, endMs: next.getTime() });
               curr = next;
           }
       } else { // daily
           while(curr.getTime() <= maxMs) {
               let startMs = curr.getTime();
               let next = new Date(curr);
               next.setDate(next.getDate() + 1);
               bins.push({ label: curr.toLocaleDateString('en-GB', {day: '2-digit', month: 'short'}), startMs: startMs, endMs: next.getTime() });
               curr = next;
           }
       }

       let chartLabels = [];
       let chartAct = []; let chartMkt = []; let chartGrossAsp = []; let chartNetAsp = [];
       let clickableEvents = [];

       // --- NEW: DYNAMIC LOOKBACK WINDOW BASED ON TIMELINE ---
       let lookbackDays = timeline === 'monthly' ? 30 : (timeline === 'weekly' ? 7 : 1);
       let lookbackMs = (lookbackDays - 1) * 86400000;

       bins.forEach((bin, idx) => {
           // 2. Dynamic Sniper & Trailing Average Logic
           let historicalSales = productSales.filter(s => s.dateMs < bin.endMs);
           let calcGross = null;
           let calcNet = null;
           
           // Default boundaries (used if no sales exist yet)
           let iStartMs = bin.startMs;
           let iEndMs = bin.endMs;
           let iLabel = bin.label;

           if (historicalSales.length > 0) {
               // Find the most recent active sales day on or before this bin's end
               historicalSales.sort((a, b) => b.dateMs - a.dateMs);
               let latestSale = historicalSales[0];
               let spotSales = [];

               if (timeline === 'daily') {
                   // BULLETPROOF: Match the exact calendar string to avoid JS Timezone/Parse errors
                   spotSales = historicalSales.filter(s => s.date === latestSale.date);
               } else {
                   // Trailing window matching (7 or 30 days) using raw milliseconds
                   let windowStartMs = latestSale.dateMs - lookbackMs;
                   spotSales = historicalSales.filter(s => s.dateMs >= windowStartMs && s.dateMs <= latestSale.dateMs);
               }
               
               let gRev = 0, nRev = 0, qty = 0;
               spotSales.forEach(s => { gRev += s.grossRev; nRev += s.netRev; qty += s.qty; });

               if (qty > 0) {
                   calcGross = Number((gRev / qty).toFixed(2));
                   calcNet = Number((nRev / qty).toFixed(2));
               }
               
               // Dynamically shift the Modal Inspector boundaries to match the exact mathematical window
               let spotLabelFmt = new Date(latestSale.dateMs).toLocaleDateString('en-GB', {day:'numeric', month:'short'});
               iStartMs = timeline === 'daily' ? latestSale.dateMs : latestSale.dateMs - lookbackMs;
               iEndMs = latestSale.dateMs + 86400000; 
               iLabel = timeline === 'daily' ? `Spot Day: ${spotLabelFmt}` : `Trailing ${lookbackDays}d ending ${spotLabelFmt}`;
           }

           // Carry forward ASP and Inspector parameters if no sales existed before this bin
           if (calcGross === null && idx > 0) {
               calcGross = chartGrossAsp[idx - 1];
               calcNet = chartNetAsp[idx - 1];
               iStartMs = clickableEvents[idx - 1].inspectStartMs;
               iEndMs = clickableEvents[idx - 1].inspectEndMs;
               iLabel = clickableEvents[idx - 1].inspectLabel;
           }

           chartGrossAsp.push(calcGross);
           chartNetAsp.push(calcNet);

           // 3. Find the active Cost FOR this period (latest cost event on or before the bin ends)
           let activeEv = changeEvents[0];
           for (let i = 0; i < changeEvents.length; i++) {
               if (new Date(changeEvents[i].date).getTime() < bin.endMs) activeEv = changeEvents[i];
               else break;
           }

           chartLabels.push(bin.label);
           chartAct.push(activeEv ? activeEv.unitActual : null);
           chartMkt.push(activeEv ? activeEv.unitMarket : null);

           // Store the exact, mathematically synchronized bin state for the Lineage Inspector
           clickableEvents.push({ ...activeEv, inspectStartMs: iStartMs, inspectEndMs: iEndMs, inspectLabel: iLabel });
       });

       // =================================================================
       // --- RENDER CHART ---
       // =================================================================
       const ctx = document.getElementById('costingTrendChart').getContext('2d');
       if(appState.cChartInstance) appState.cChartInstance.destroy();
       
       let datasets = [];
       if (appState.cFilters.view === 'actual' || appState.cFilters.view === 'compare') {
          datasets.push({ label: 'Actual Unit Cost', data: chartAct, borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: appState.cFilters.view === 'actual', tension: 0, borderWidth: 3, pointHitRadius: 15 });
       }
       if (appState.cFilters.view === 'market' || appState.cFilters.view === 'compare') {
          datasets.push({ label: 'Market Unit Cost', data: chartMkt, borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: appState.cFilters.view === 'market', tension: 0, borderWidth: 3, borderDash: appState.cFilters.view === 'compare' ? [5, 5] : [], pointHitRadius: 15 });
       }
       datasets.push({ label: 'Gross ASP', data: chartGrossAsp, borderColor: '#94a3b8', backgroundColor: 'transparent', borderWidth: 2, borderDash: [2, 2], pointRadius: 3, pointHitRadius: 10, spanGaps: true });
       datasets.push({ label: 'Net ASP (True)', data: chartNetAsp, borderColor: '#10b981', backgroundColor: 'transparent', borderWidth: 3, borderDash: [4, 4], pointRadius: 5, pointHitRadius: 15, spanGaps: true });

       appState.cChartInstance = new Chart(ctx, {
          type: 'line',
          data: { labels: chartLabels, datasets: datasets },
          options: { 
             responsive: true, maintainAspectRatio: false, 
             plugins: { 
                legend: { position: 'top' },
                tooltip: {
                   callbacks: {
                      label: function(context) {
                         let label = context.dataset.label || '';
                         let val = context.parsed.y;
                         let netAsp = chartNetAsp[context.dataIndex];
                         if (label) label += ': ';
                         label += val.toFixed(2) + ' EGP';
                         
                         if (context.dataset.label.includes('Cost') && netAsp && netAsp > 0) {
                            let gp = (((netAsp - val) / netAsp) * 100).toFixed(1);
                            label += ` (Net GP: ${gp}%)`;
                         }
                         return label;
                      }
                   }
                }
             },
             interaction: { mode: 'index', intersect: false },
             onClick: (e, activeEls) => {
                if (activeEls.length > 0) {
                   let idx = activeEls[0].index;
                   let ev = clickableEvents[idx];
                   
                   appState.activeInspectPeriod = {
                      startMs: ev.inspectStartMs,
                      endMs: ev.inspectEndMs,
                      dateLabel: ev.inspectLabel,
                      bomEvent: ev
                   };
                   
                   let inspectBtn = document.getElementById('btn-inspect-transactions');
                   if(inspectBtn) inspectBtn.classList.remove('d-none');
                   
                   // Support both naming conventions for the side panel function
                   if(typeof renderSidePanel === 'function') {
                   renderSidePanel(ev);
               } else if(typeof renderCostingBom === 'function') {
                   document.getElementById('bom-panel-subtitle').innerHTML = `<i class="fas fa-calendar-day me-1"></i>${ev.inspectLabel}`;
                   renderCostingBom(ev);
               }
            }
         }
      }
   });

   // Hook: Auto-update the Executive View if it is currently active
   if (appState.execState && appState.execState.isSummary) {
       renderExecutiveSummary();
   }
}

