                id: 'centerText',
                beforeDraw: function(chart) {
                   if (appState.cFilters.view !== 'compare') return;
                   const ctx = chart.ctx; ctx.restore();
                   ctx.font = 'bold 9px sans-serif'; ctx.fillStyle = '#94a3b8'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                   const centerX = (chart.chartArea.left + chart.chartArea.right) / 2;
                   const centerY = (chart.chartArea.top + chart.chartArea.bottom) / 2;
                   ctx.fillText('INNER: ACTUAL', centerX, centerY - 8);
                   ctx.fillText('OUTER: MARKET', centerX, centerY + 8);
                   ctx.save();
                }
             },
             {
                id: 'sliceLabels',
                afterDatasetsDraw: function(chart) {
                   const ctx = chart.ctx;
                   chart.data.datasets.forEach((dataset, i) => {
                      const meta = chart.getDatasetMeta(i); if (meta.hidden) return;
                      let total = dataset.data.reduce((a,b)=>a+b,0);
                      if (total === 0) return;
                      meta.data.forEach((element, index) => {
                         const pct = (dataset.data[index] / total) * 100;
                         if (pct > 7) { 
                            ctx.fillStyle = '#ffffff'; ctx.font = 'bold 10px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                            ctx.shadowColor = "rgba(0,0,0,0.6)"; ctx.shadowBlur = 3;
                            const pos = element.tooltipPosition();
                            ctx.fillText(Math.round(pct) + '%', pos.x, pos.y);
                            ctx.shadowBlur = 0;
                         }
                      });
                   });
                }
             }
          ],
          options: { 
             responsive: true, maintainAspectRatio: false, 
             plugins: { 
                 legend: { display: false },
                 tooltip: { callbacks: { label: function(c) { return ` ${c.label}: ${c.raw.toFixed(2)} EGP`; } } }
             }, 
             cutout: isCompare ? '45%' : '65%' 
          }
