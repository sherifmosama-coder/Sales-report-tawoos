    function renderCostingDashboard() {
       // --- NEW: DYNAMIC HEADER & DESCRIPTION ENGINE ---
       const currentView = appState.cFilters.view;
       const currentProduct = appState.cFilters.product;
       let stateTitle = "";
       let stateDesc = "";
       let stateIcon = "";

       if (currentView === 'actual') {
          stateTitle = "Actual Cost Analysis";
          stateIcon = "fa-file-invoice-dollar text-primary";
          stateDesc = "Calculated using the latest verified acquisition prices from the Purchases ledger. This represents the current real-time replacement cost of the product's Bill of Materials.";
       } else if (currentView === 'market') {
          stateTitle = "Market (Indicative) Projections";
          stateIcon = "fa-bolt-lightning text-danger";
          stateDesc = "Reflects indicative price overrides entered manually to anticipate upcoming market shifts. This allows for margin forecasting before new purchase prices are officially realized.";
       } else {
          stateTitle = "Comparative Variance Analysis";
          stateIcon = "fa-code-compare text-warning";
          stateDesc = "A dual-layered reconciliation of verified actuals against manual market projections. This view isolates cost variance and highlights potential margin exposure from upcoming volatility.";
       }

       document.getElementById('costing-chart-header').innerHTML = `
          <div class="d-flex justify-content-between align-items-start border-bottom pb-3">
             <div class="flex-grow-1">
                <h4 class="fw-bold text-dark mb-1" style="letter-spacing: -0.5px;">${currentProduct}</h4>
                <div class="d-flex align-items-center">
                   <span class="badge bg-light text-dark border rounded-pill px-3 py-1" style="font-size: 0.7rem;">
                      <i class="fas ${stateIcon} me-2"></i>${stateTitle}
                   </span>
                </div>
             </div>
             <div class="ms-4 text-end d-none d-md-block" style="max-width: 450px;">
                <p class="text-muted mb-0 fw-medium" style="font-size: 0.8rem; line-height: 1.5; font-style: italic;">
                   "${stateDesc}"
                </p>
             </div>
          </div>
       `;

       // 1. IDENTIFY VOLATILE MATERIALS & BUILD SCORECARDS
       const alertMats = new Set((appState.globalAlerts || []).map(a => a.mat));
       const catProducts = [...new Set(appState.costingData.filter(d => d.category === appState.cFilters.category).map(d => d.product))].sort();
       
       if (!catProducts.includes(appState.cFilters.product)) {
           appState.cFilters.product = catProducts.includes('خل الطاووس ( 900 مللي )') ? 'خل الطاووس ( 900 مللي )' : (catProducts.length > 0 ? catProducts[0] : 'All');
       }
       
       let scorecardHtml = '';
       catProducts.forEach(p => {
           const pHistory = appState.costingData.filter(d => d.product === p).sort((a,b) => new Date(b.date) - new Date(a.date));
           const latestEntry = pHistory[0] || {};
           const actCost = latestEntry.unitActual || 0;
           const mktCost = latestEntry.unitMarket || 0;
           const displayCost = Math.abs(actCost - mktCost) > 0.01 ? mktCost : actCost;
           
           const thirtyDaysAgo = Date.now() - (30 * 24 * 60 * 60 * 1000);
           const recentSales = appState.productData.filter(s => s.item === p && new Date(s.date).getTime() >= thirtyDaysAgo);
           let rev = 0; let qty = 0;
           recentSales.forEach(s => { rev += s.rev; qty += s.qty; });
           const currentAsp = qty > 0 ? (rev / qty) : 0;
           
           const gpVal = currentAsp - displayCost;
           const gpPct = currentAsp > 0 ? ((gpVal / currentAsp) * 100).toFixed(1) : 0;

           let needsAttention = false;
           if (latestEntry.bomMeta) {
               needsAttention = Object.keys(latestEntry.bomMeta).some(m => alertMats.has(m));
           }

           const isActive = appState.cFilters.product === p ? 'active' : '';
           const alertClass = needsAttention ? 'needs-attention alert-pulse' : '';
           const gpColor = gpVal >= 0 ? 'text-success' : 'text-danger';

           scorecardHtml += `
           <div class="product-card rounded-3 p-2 m-1 d-inline-block shadow-sm ${isActive} ${alertClass}" 
                onclick="updateCostingState('product', '${p.replace(/'/g, "\\'")}')" 
                style="width: 190px; vertical-align: top;">
              <div class="d-flex justify-content-between align-items-start mb-1">
                 <span class="fw-bold text-dark text-truncate" style="font-size:0.75rem; max-width:140px;">${p}</span>
                 ${needsAttention ? '<i class="fas fa-exclamation-circle text-danger" style="font-size:0.7rem;"></i>' : ''}
              </div>
              <div class="row g-0 mt-2 border-top pt-2">
                 <div class="col-4 border-end">
                    <div class="text-muted" style="font-size:0.5rem; font-weight:800;">COST</div>
                    <div class="fw-bold text-primary" style="font-size:0.7rem;">${displayCost.toFixed(1)}</div>
                 </div>
                 <div class="col-4 border-end ps-1">
                    <div class="text-muted" style="font-size:0.5rem; font-weight:800;">ASP</div>
                    <div class="fw-bold text-dark" style="font-size:0.7rem;">${currentAsp > 0 ? currentAsp.toFixed(1) : '--'}</div>
                 </div>
                 <div class="col-4 ps-1">
                    <div class="text-muted" style="font-size:0.5rem; font-weight:800;">GP%</div>
                    <div class="fw-bold ${gpColor}" style="font-size:0.7rem;">${gpPct}%</div>
                 </div>
              </div>
           </div>`;
       });
       
       document.getElementById('costing-product-toggles').innerHTML = scorecardHtml;

       // 2. Isolate COST SHIFT EVENTS
       const rawCostData = appState.costingData.filter(d => d.product === appState.cFilters.product);
       const chronoCostData = [...rawCostData].sort((a, b) => new Date(a.date) - new Date(b.date));
       
       let changeEvents = [];
       let lastActual = null; let lastMarket = null;
       for (let i = 0; i < chronoCostData.length; i++) {
          let d = chronoCostData[i];
          if (i === 0 || d.unitActual !== lastActual || d.unitMarket !== lastMarket) {
             changeEvents.push(d);
             lastActual = d.unitActual; lastMarket = d.unitMarket;
          }
       }

       // 3. Calculate ASP between shifts
       let chartLabels = []; let chartAct = []; let chartMkt = []; let chartAsp = [];
       changeEvents.forEach((ev, idx) => {
          chartLabels.push(ev.date);
          chartAct.push(ev.unitActual);
          chartMkt.push(ev.unitMarket);

          let startDateMs = new Date(ev.date).getTime();
          let endDateMs = (idx < changeEvents.length - 1) ? new Date(changeEvents[idx+1].date).getTime() : Date.now();
          
          let salesInPeriod = appState.productData.filter(s => 
             s.item === appState.cFilters.product && 
             new Date(s.date).getTime() >= startDateMs && 
             new Date(s.date).getTime() <= endDateMs
          );
          
          let rev = 0; let qty = 0;
          salesInPeriod.forEach(s => { rev += s.rev; qty += s.qty; });
          chartAsp.push(qty > 0 ? Number((rev / qty).toFixed(2)) : null);
       });

       // 4. Render Chart with Dynamic Tooltip GP%
       const ctx = document.getElementById('costingTrendChart').getContext('2d');
       if(appState.cChartInstance) appState.cChartInstance.destroy();
       
       let datasets = [];
       if (appState.cFilters.view === 'actual' || appState.cFilters.view === 'compare') {
          datasets.push({ label: 'Actual Unit Cost', data: chartAct, borderColor: '#3b82f6', backgroundColor: 'rgba(59, 130, 246, 0.1)', fill: appState.cFilters.view === 'actual', tension: 0, borderWidth: 3, pointHitRadius: 15 });
       }
       if (appState.cFilters.view === 'market' || appState.cFilters.view === 'compare') {
          datasets.push({ label: 'Market Unit Cost', data: chartMkt, borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: appState.cFilters.view === 'market', tension: 0, borderWidth: 3, borderDash: appState.cFilters.view === 'compare' ? [5, 5] : [], pointHitRadius: 15 });
       }
       datasets.push({ label: 'Avg Selling Price', data: chartAsp, borderColor: '#10b981', backgroundColor: 'rgba(16, 185, 129, 0)', borderWidth: 3, borderDash: [4, 4], pointRadius: 5, pointHitRadius: 15, spanGaps: true });

       appState.cChartInstance = new Chart(ctx, {
          type: 'line',
          data: { labels: chartLabels, datasets: datasets },
          options: { 
             responsive: true, maintainAspectRatio: false, 
             plugins: { 
                legend: { position: 'top' },
                tooltip: {
                   callbacks: {
                      label: function(context) {
                         let label = context.dataset.label || '';
                         let val = context.parsed.y;
                         let asp = chartAsp[context.dataIndex];
                         if (label) label += ': ';
                         label += val.toFixed(2) + ' EGP';
                         
                         // Injection: Show GP% on Cost lines if ASP exists for that specific point
                         if (context.dataset.label.includes('Cost') && asp && asp > 0) {
                            let gp = (((asp - val) / asp) * 100).toFixed(1);
                            label += ` (GP: ${gp}%)`;
                         }
                         return label;
                      }
                   }
                }
             },
             interaction: { mode: 'index', intersect: false },
             onClick: (e, activeEls) => {
                if (activeEls.length > 0) renderSidePanel(changeEvents[activeEls[0].index]);
             }
          }
       });

       if (changeEvents.length > 0) {
          renderSidePanel(changeEvents[changeEvents.length - 1]);
       } else {
          document.getElementById('bom-panel-subtitle').innerText = "No Data";
          document.getElementById('bom-panel-table-body').innerHTML = '<tr><td colspan="4" class="text-center text-muted p-4">No data available.</td></tr>';
          if(appState.cDoughnutChart) { appState.cDoughnutChart.destroy(); appState.cDoughnutChart = null; }
       }
    }

    function renderSidePanel(eventData) {
       document.getElementById('bom-panel-subtitle').innerText = `Date: ${eventData.date}`;

       let isCompare = appState.cFilters.view === 'compare';
       let isMarket = appState.cFilters.view === 'market';
       
       let allMats = new Set([...Object.keys(eventData.bomActual || {}), ...Object.keys(eventData.bomMarket || {})]);
       
       // 1. OMIT ZERO-COST MATERIALS
       let validMats = Array.from(allMats).filter(mat => {
           let a = eventData.bomActual[mat] || 0;
           let m = eventData.bomMarket[mat] || 0;
           return a > 0 || m > 0;
       });

       // Sort Highest Cost First
       let sortedMats = validMats.sort((a,b) => {
           let valA = isMarket ? (eventData.bomMarket[a]||0) : (eventData.bomActual[a]||0);
           let valB = isMarket ? (eventData.bomMarket[b]||0) : (eventData.bomActual[b]||0);
           return valB - valA; 
       });

       let chartLabels = []; let actData = []; let mktData = []; 
       let actBgColors = []; let mktBgColors = [];
       let chartColors = ['#3b82f6','#ef4444','#10b981','#f59e0b','#6366f1','#ec4899','#8b5cf6','#14b8a6','#f97316','#06b6d4', '#94a3b8'];

       let tHead = ''; let tBody = '';
       let totalAct = 0; let totalMkt = 0; // NEW: Running Totals

       if (isCompare) {
           tHead = `<tr>
              <th class="ps-2 text-muted fw-bold" style="font-size: 0.7rem;">MATERIAL</th>
              <th class="text-end text-primary fw-bold" style="font-size: 0.7rem;">ACTUAL</th>
              <th class="text-end text-danger fw-bold" style="font-size: 0.7rem;">MARKET</th>
              <th class="text-end pe-2 text-muted fw-bold" style="font-size: 0.7rem;">RATE (ACT / MKT)</th>
           </tr>`;
       } else {
           tHead = `<tr>
              <th class="ps-2 text-muted fw-bold" style="font-size: 0.7rem;">MATERIAL</th>
              <th class="text-end text-muted fw-bold" style="font-size: 0.7rem;">CONTRIBUTED</th>
              <th class="text-end pe-2 text-muted fw-bold" style="font-size: 0.7rem;">MATERIAL RATE</th>
           </tr>`;
       }
       document.querySelector('#bom-panel-table-body').parentElement.querySelector('thead').innerHTML = tHead;

       sortedMats.forEach((mat, idx) => {
          let baseColor = chartColors[idx % chartColors.length];
          let actVal = eventData.bomActual[mat] || 0;
          let mktVal = eventData.bomMarket[mat] || 0;
          
          totalAct += actVal; // Add to Actual Total
          totalMkt += mktVal; // Add to Market Total

          // BULLETPROOF META EXTRACTION & HISTORICAL FALLBACK
          let meta = (eventData.bomMeta && eventData.bomMeta[mat]) ? eventData.bomMeta[mat] : {};
          let aRate = meta.actRate || 0;
          let mRate = meta.mktRate || meta.rate || 0;
          let unit = meta.unit || 'Unit';

          // If Actual Rate is missing (old historical data), reverse-engineer it from the BOM ratio!
          if (aRate === 0 && actVal > 0 && mktVal > 0 && mRate > 0) {
              aRate = (actVal * mRate) / mktVal;
          }

          chartLabels.push(mat);
          actData.push(actVal);
          mktData.push(mktVal);

          let isSame = Math.abs(actVal - mktVal) < 0.01;
          if (isCompare && isSame) {
              actBgColors.push(baseColor + '40'); 
              mktBgColors.push(baseColor + '40');
          } else {
              actBgColors.push(baseColor);
              mktBgColors.push(baseColor);
          }

          let rateStr = '';
          if (isCompare) {
             if (Math.abs(aRate - mRate) > 0.01 && aRate > 0 && mRate > 0) {
                 rateStr = `<span class="text-primary">${aRate.toFixed(2)}</span> / <span class="text-danger">${mRate.toFixed(2)}</span> <span class="text-muted" style="font-size:0.6rem;">${unit}</span>`;
             } else {
                 let displayRate = aRate > 0 ? aRate : mRate;
                 rateStr = displayRate > 0 ? `${displayRate.toFixed(2)} <span class="text-muted" style="font-size:0.6rem;">${unit}</span>` : '-';
             }
          } else {
             let activeRate = isMarket ? mRate : aRate;
             if (activeRate === 0 && (aRate > 0 || mRate > 0)) activeRate = aRate > 0 ? aRate : mRate; 
             rateStr = activeRate > 0 ? `${activeRate.toFixed(2)} <span class="text-muted" style="font-size:0.6rem;">${unit}</span>` : '-';
          }

          let safeMatName = mat.replace(/'/g, "\\'"); 
          
          if (isCompare) {
              tBody += `<tr class="bom-row-clickable" onclick="openMaterialHistory('${safeMatName}')">
                 <td class="fw-bold text-dark ps-2" style="font-size: 0.75rem;"><i class="fas fa-circle me-2" style="color:${isSame ? baseColor+'40' : baseColor}; font-size:0.6rem;"></i>${mat}</td>
                 <td class="text-end text-primary fw-bold" style="font-size: 0.8rem;">${actVal.toFixed(2)}</td>
                 <td class="text-end text-danger fw-bold" style="font-size: 0.8rem;">${mktVal.toFixed(2)}</td>
                 <td class="text-end pe-2 fw-bold text-muted" style="font-size: 0.75rem;">${rateStr}</td>
              </tr>`;
          } else {
              let displayVal = isMarket ? mktVal : actVal;
              let valColor = isMarket ? 'text-danger' : 'text-primary';
              tBody += `<tr class="bom-row-clickable" onclick="openMaterialHistory('${safeMatName}')">
                 <td class="fw-bold text-dark ps-2" style="font-size: 0.75rem;"><i class="fas fa-circle me-2" style="color:${baseColor}; font-size:0.6rem;"></i>${mat}</td>
                 <td class="text-end ${valColor} fw-bold" style="font-size: 0.8rem;">${displayVal.toFixed(2)}</td>
                 <td class="text-end pe-2 fw-bold text-muted" style="font-size: 0.75rem;">${rateStr}</td>
              </tr>`;
          }
       });

       // --- Prominent Total BOM Cost Row ---
       let footerHtml = '';
       if (isCompare) {
           footerHtml = `
           <tr class="bg-warning bg-opacity-10 border-top border-warning">
              <td class="fw-bold text-dark ps-2 py-3" style="font-size: 0.8rem;"><i class="fas fa-coins me-2 text-warning"></i>TOTAL BOM COST</td>
              <td class="text-end text-primary fw-bold py-3" style="font-size: 0.9rem;">${totalAct.toFixed(2)}</td>
              <td class="text-end text-danger fw-bold py-3" style="font-size: 0.9rem;">${totalMkt.toFixed(2)}</td>
              <td class="text-end pe-2"></td>
           </tr>`;
       } else {
           let displayTotal = isMarket ? totalMkt : totalAct;
           let totalColor = isMarket ? 'text-danger' : 'text-primary';
           footerHtml = `
           <tr class="bg-warning bg-opacity-10 border-top border-warning">
              <td class="fw-bold text-dark ps-2 py-3" style="font-size: 0.8rem;"><i class="fas fa-coins me-2 text-warning"></i>TOTAL BOM COST</td>
              <td class="text-end ${totalColor} fw-bold py-3" style="font-size: 0.9rem;">${displayTotal.toFixed(2)}</td>
              <td class="text-end pe-2"></td>
           </tr>`;
       }

       document.getElementById('bom-panel-table-body').innerHTML = tBody + footerHtml;

       // NESTED DOUGHNUT WITH INLINE PLUGINS
       const dCtx = document.getElementById('bomDoughnut').getContext('2d');
       if(appState.cDoughnutChart) appState.cDoughnutChart.destroy();
       
       let doughnutDatasets = [];
       if (isCompare) {
           doughnutDatasets.push({ data: actData, backgroundColor: actBgColors, borderWidth: 1, borderColor: '#fff' }); 
           doughnutDatasets.push({ data: mktData, backgroundColor: mktBgColors, borderWidth: 1, borderColor: '#fff' }); 
       } else {
           doughnutDatasets.push({ data: isMarket ? mktData : actData, backgroundColor: actBgColors, borderWidth: 2, borderColor: '#fff' });
       }

       appState.cDoughnutChart = new Chart(dCtx, {
          type: 'doughnut',
          data: { labels: chartLabels, datasets: doughnutDatasets },
          plugins: [
             {
                id: 'centerText',
                beforeDraw: function(chart) {
                   if (appState.cFilters.view !== 'compare') return;
                   const ctx = chart.ctx; ctx.restore();
                   ctx.font = 'bold 9px sans-serif'; ctx.fillStyle = '#94a3b8'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                   const centerX = (chart.chartArea.left + chart.chartArea.right) / 2;
                   const centerY = (chart.chartArea.top + chart.chartArea.bottom) / 2;
                   ctx.fillText('INNER: ACTUAL', centerX, centerY - 8);
                   ctx.fillText('OUTER: MARKET', centerX, centerY + 8);
                   ctx.save();
                }
             },
             {
                id: 'sliceLabels',
                afterDatasetsDraw: function(chart) {
                   const ctx = chart.ctx;
                   chart.data.datasets.forEach((dataset, i) => {
                      const meta = chart.getDatasetMeta(i); if (meta.hidden) return;
                      let total = dataset.data.reduce((a,b)=>a+b,0);
                      if (total === 0) return;
                      meta.data.forEach((element, index) => {
                         const pct = (dataset.data[index] / total) * 100;
                         if (pct > 7) { 
                            ctx.fillStyle = '#ffffff'; ctx.font = 'bold 10px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
                            ctx.shadowColor = "rgba(0,0,0,0.6)"; ctx.shadowBlur = 3;
                            const pos = element.tooltipPosition();
                            ctx.fillText(Math.round(pct) + '%', pos.x, pos.y);
                            ctx.shadowBlur = 0;
                         }
                      });
                   });
                }
             }
          ],
          options: { 
             responsive: true, maintainAspectRatio: false, 
             plugins: { 
                 legend: { display: false },
                 tooltip: { callbacks: { label: function(c) { return ` ${c.label}: ${c.raw.toFixed(2)} EGP`; } } }
             }, 
             cutout: isCompare ? '45%' : '65%' 
          }
       });
    }

