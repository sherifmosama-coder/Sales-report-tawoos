        let sortMode = document.getElementById('cad-filter-sort').value;
        
        let msPerDay = 1000 * 60 * 60 * 24;
        let cutoffMs = 0;
        if (period === '12') cutoffMs = Date.now() - (365 * msPerDay);
        if (period === '6') cutoffMs = Date.now() - (180 * msPerDay);

        let filtered = appState.cadenceAlerts.filter(a => {
            if (cutoffMs > 0 && a.lastOrderDate < cutoffMs) return false;
            if (pType !== 'All' && a.category !== pType) return false;
