    function formatK(n) { return n>=1000?(n/1000).toFixed(1)+'k':n.toLocaleString(); }
    function parseDate(s) { 
      if (!s || s === "0000-00-00") return null; 

      // 1. Standard ISO Date (YYYY-MM-DD) - Coming from New Source
      // We check if it starts with 4 digits followed by dash or slash
      if (/^\d{4}[-\/]\d{2}[-\/]\d{2}/.test(s)) {
        // Create date explicitly to avoid Timezone shifts
        const parts = s.split(/[-\/]/); // Split by - or /
        // new Date(Year, MonthIndex, Day) -> Month is 0-11
        return new Date(parts[0], parts[1] - 1, parts[2]); 
      }
      
      // 2. Legacy Arabic Format (DD-MonthName-YYYY)
      const m={"يناير":0,"فبراير":1,"مارس":2,"أبريل":3,"مايو":4,"يونيو":5,"يوليو":6,"أغسطس":7,"سبتمبر":8,"أكتوبر":9,"نوفمبر":10,"ديسمبر":11};
      try {
        const p = s.split('-');
        return p.length===3 ? new Date(p[2], m[p[1]]||0, p[0]) : new Date(s);
      } catch (e) { return null; }
    }

    // --- PRODUCT DASHBOARD ENGINE ---
    function renderProductDashboard() {
      const data = appState.productData;
      if (!data || data.length === 0) return;

      const dateInput = document.getElementById('report-date').value;
      if (!dateInput) return;
      const refDate = new Date(dateInput);
      
      const timeframe = document.querySelector('input[name="timeframe"]:checked').value;
      const measure = document.querySelector('input[name="measure"]:checked').value;
      const { category, line, item } = appState.pFilters;

      // 1. Define Time Ranges (Apple-to-Apple)
      const currentYear = refDate.getFullYear();
      let startCurr, endCurr, startPrev, endPrev;

      if (timeframe === 'year') {
         startCurr = new Date(currentYear, 0, 1);
         endCurr = refDate;
         startPrev = new Date(currentYear - 1, 0, 1);
         endPrev = new Date(currentYear - 1, refDate.getMonth(), refDate.getDate());
      } 
      else if (timeframe === 'quarter') {
         const q = Math.floor(refDate.getMonth() / 3);
         startCurr = new Date(currentYear, q * 3, 1);
         endCurr = refDate;
         startPrev = new Date(currentYear - 1, q * 3, 1);
         endPrev = new Date(currentYear - 1, refDate.getMonth(), refDate.getDate());
      } 
      else { // Month
         startCurr = new Date(currentYear, refDate.getMonth(), 1);
         endCurr = refDate;
         startPrev = new Date(currentYear - 1, refDate.getMonth(), 1);
         endPrev = new Date(currentYear - 1, refDate.getMonth(), refDate.getDate());
      }

      // 2. Filter Data (Hierarchy + Time)
      const isMatch = (d, start, end) => {
         // Hierarchy Filter
         if (category !== 'All' && d.category !== category) return false;
         const isPrivate = (d.line === true || String(d.line).toUpperCase() === 'TRUE');
         if (line === 'Own' && isPrivate) return false;
         if (line === 'Private' && !isPrivate) return false;
         if (item !== 'All' && d.item !== item) return false;
         
         // Date Filter
         const dDate = new Date(d.date); // d.date is "YYYY-MM-DD"
         dDate.setHours(0,0,0,0); // normalize
         return dDate >= start && dDate <= end;
      };

      let currTotal = 0, prevTotal = 0;
      let currItems = {}, prevItems = {};
      let currTrend = {}, prevTrend = {};

      data.forEach(d => {
         const val = measure === 'qty' ? d.qty : d.rev;
         
         // Current Period
         if (isMatch(d, startCurr, endCurr)) {
            currTotal += val;
            if(!currItems[d.item]) currItems[d.item] = 0;
            currItems[d.item] += val;
            
            // Trend (Day of Period)
            const dayKey = d.date.substring(5); // MM-DD
            if(!currTrend[dayKey]) currTrend[dayKey] = 0;
            currTrend[dayKey] += val;
         }
         
         // Previous Period
         if (isMatch(d, startPrev, endPrev)) {
            prevTotal += val;
            const dayKey = d.date.substring(5);
            if(!prevTrend[dayKey]) prevTrend[dayKey] = 0;
            prevTrend[dayKey] += val;
         }
      });

      // 3. Update KPIs
      const fmt = (n) => measure === 'rev' ? 
        new Intl.NumberFormat('en-US', { style: 'currency', currency: 'EGP', maximumFractionDigits:0 }).format(n) : 
        formatK(n);
      
      const growth = prevTotal > 0 ? ((currTotal - prevTotal) / prevTotal) * 100 : 0;
      const color = growth >= 0 ? 'text-success' : 'text-danger';
      
      document.getElementById('kpi-curr').innerText = fmt(currTotal);
      document.getElementById('kpi-prev').innerText = fmt(prevTotal);
      document.getElementById('kpi-growth').innerHTML = `<span class="${color}">${growth >= 0 ? '↑' : '↓'} ${Math.abs(growth).toFixed(1)}%</span>`;
      
      const dateFmt = (d) => d.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' });
      document.getElementById('kpi-range-curr').innerText = `${dateFmt(startCurr)} - ${dateFmt(endCurr)}`;
      document.getElementById('kpi-range-prev').innerText = `${dateFmt(startPrev)} - ${dateFmt(endPrev)}`;

      // 4. Update Chart (Cumulative)
      updateProductChart(currTrend, prevTrend, startCurr, endCurr);

      // 5. Update Product List
      updateProductList(currItems, measure);
    }

    function updateProductChart(currTrend, prevTrend, start, end) {
       const ctx = document.getElementById('productTrendChart').getContext('2d');
       if(appState.pChart) appState.pChart.destroy();
       
       // Generate Labels (Days in range)
       let labels = [];
       let cData = [], pData = [];
       let cAcc = 0, pAcc = 0;
       
       for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
          const key = ('0' + (d.getMonth()+1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
          labels.push(key);
          
          cAcc += (currTrend[key] || 0);
          pAcc += (prevTrend[key] || 0);
          cData.push(cAcc);
          pData.push(pAcc);
       }

       appState.pChart = new Chart(ctx, {
          type: 'line',
          data: {
             labels: labels,
             datasets: [
                { label: 'Current', data: cData, borderColor: '#16a34a', backgroundColor: 'rgba(22, 163, 74, 0.1)', fill: true, tension: 0.3 },
                { label: 'Previous', data: pData, borderColor: '#94a3b8', borderDash: [5, 5], fill: false, tension: 0.3 }
             ]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' } }, scales: { x: { display: false } } }
       });
    }

    function updateProductList(itemsMap, measure) {
       const container = document.getElementById('product-list-container');
       const sorted = Object.entries(itemsMap).sort((a,b) => b[1] - a[1]).slice(0, 10);
       
       if (sorted.length === 0) {
          container.innerHTML = `<div class="col-12 text-center text-muted py-3">No data for this selection</div>`;
          return;
       }

       let html = '';
       sorted.forEach(([name, val]) => {
          const displayVal = measure === 'rev' ? 
             new Intl.NumberFormat('en-US', { style: 'currency', currency: 'EGP', maximumFractionDigits:0 }).format(val) : 
             formatK(val);
             
          html += `
             <div class="col-md-6 col-lg-4">
                <div class="p-2 border rounded bg-white d-flex align-items-center justify-content-between shadow-sm">
                   <div class="text-truncate" style="font-size:0.9rem; font-weight:600; color:#334155;">${name}</div>
                   <div class="badge bg-light text-dark border">${displayVal}</div>
                </div>
             </div>
          `;
       });
       container.innerHTML = html;
    }
  </script>
</body>
