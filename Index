    // --- SHARED DATA PROCESSOR (For UI & Export) ---
    // --- SHARED DATA PROCESSOR (For UI & Export) ---
    function getProcessedData() {
        // Safety Check
        const rawData = (appState.rawData && Array.isArray(appState.rawData)) ? appState.rawData : [];

        const riskMode = document.getElementById('riskFilter').value;
        const searchVal = document.getElementById('search').value.toLowerCase();
        
        // 1. Base Aggregation
        let list = aggregateForList(rawData);

        // 2. Filters
        list = list.filter(c => {
           // --- NEW: Client Segment Filter (Connects Top Toggles to List) ---
           if (appState.selectedType !== 'All' && c.type !== appState.selectedType) return false;
           // -----------------------------------------------------------------

           // Risk Filter
           if (riskMode === 'Stopped') {
               // Calculate "Stopped" dynamically (No transaction in last 6 months)
               const sixMonthsAgo = new Date();
               sixMonthsAgo.setMonth(sixMonthsAgo.getMonth() - 6);
               const lastDate = c.lastTx ? new Date(c.lastTx) : new Date('2000-01-01');
               if (lastDate > sixMonthsAgo) return false; // It is active, so skip
           }
           
           // Declining Logic: Growth is negative (worse than -5%)
           if (riskMode === 'Declining') {
               if (c.growth === null || c.growth >= -0.05) return false;
           }
           
           // Search Filter
           if (searchVal && !c.client.toLowerCase().includes(searchVal)) return false;
           
           return true;
        });

        // 3. Sorting
        const sortFn = (a, b) => {
            let va = a[appState.sortBy], vb = b[appState.sortBy];
            if(appState.sortBy === 'name') return a.client.localeCompare(b.client);
            if(va === null) va = -9999; if(vb === null) vb = -9999;
            return vb - va; // Descending
        };

        // 4. Grouping Structure
        let finalOutput = [];
        
        if (appState.groupBy !== 'None') {
             const groups = {};
             list.forEach(item => { const k = item[appState.groupBy]||'Other'; if(!groups[k]) groups[k]=[]; groups[k].push(item); });
             
             const sortedKeys = Object.keys(groups).sort((k1, k2) => {
                const sum1 = groups[k1].reduce((s,i)=>s+i[appState.viewMode],0);
                const sum2 = groups[k2].reduce((s,i)=>s+i[appState.viewMode],0);;
                return sum2 - sum1;
             });

             sortedKeys.forEach(key => {
                const groupTotal = groups[key].reduce((s,i)=>[appState.viewMode],0);;
                finalOutput.push({ isHeader: true, title: key, count: groups[key].length, total: groupTotal });
                finalOutput.push(...groups[key].sort(sortFn));
             });
        } else {
             finalOutput = list.sort(sortFn);
        }
        
        return finalOutput;
    }

