           doughnutDatasets.push({ data: mktData, backgroundColor: mktBgColors, borderWidth: 1, borderColor: '#fff' }); 
       } else {
           doughnutDatasets.push({ data: isMarket ? mktData : actData, backgroundColor: actBgColors, borderWidth: 2, borderColor: '#fff' });
       }

       appState.cDoughnutChart = new Chart(dCtx, {
          type: 'doughnut',
