    function openSyncModal() {
       document.getElementById('sync-status').style.display = 'none';
       document.getElementById('btn-sync-start').style.display = 'inline-block';
       document.getElementById('btn-sync-cancel').style.display = 'inline-block';
       const m = new bootstrap.Modal(document.getElementById('syncModal'));
