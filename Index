    // --- NEW: MATERIAL HISTORY DRILL-DOWN ENGINE ---
    appState.matHistChartInstance = null; 

    window.openMaterialHistory = function(matName) {
       let chronoData = [...appState.costingData].sort((a,b) => new Date(a.date) - new Date(b.date));
       
       let history = [];
       let unitStr = 'Unit';
       let lastKnownActRate = 0;

       // 1. EXTRACT DATA & FIX MISSING VALUES
       chronoData.forEach(d => {
           if (d.bomMeta && d.bomMeta[matName]) {
               let a = d.bomMeta[matName].actRate || 0;
               let m = d.bomMeta[matName].mktRate || d.bomMeta[matName].rate || 0;
               
               // Reverse-engineer missing Actual from BOM ratios
               let actVal = (d.bomActual && d.bomActual[matName]) ? d.bomActual[matName] : 0;
               let mktVal = (d.bomMarket && d.bomMarket[matName]) ? d.bomMarket[matName] : 0;
               if (a === 0 && actVal > 0 && mktVal > 0 && m > 0) a = (actVal * m) / mktVal;

               // Inherit the last known Actual Rate if FIFO queue was empty
               if (a === 0 && lastKnownActRate > 0) a = lastKnownActRate;
               if (a === 0 && m > 0 && lastKnownActRate === 0) a = m;
               
               if (a > 0) lastKnownActRate = a;

               // CRITICAL FIX: Market Rate MUST equal Actual Rate unless explicitly overridden
               if (m === 0 && a > 0) m = a;
               
               if (a === 0 && m === 0) return; // Skip complete zeros
               
               unitStr = d.bomMeta[matName].unit || 'Unit';
               history.push({ date: d.date, actRate: a, mktRate: m });
           }
       });

       if (history.length === 0) return;

       // 2. ISOLATE TRUE SHIFTS (Manual Updates or Actual Purchase Shifts)
       let tableData = [];
       let lastA = -1; let lastM = -1;

       history.forEach((h, idx) => {
           let isFirst = idx === 0;
           let isLast = idx === history.length - 1;
           let isShift = (Math.abs(h.actRate - lastA) > 0.01 || Math.abs(h.mktRate - lastM) > 0.01);

           if (isFirst || isLast || isShift) {
               if (tableData.length > 0 && tableData[tableData.length - 1].date === h.date) {
                   tableData[tableData.length - 1] = h; // Update in place if same date
               } else {
                   tableData.push(h);
               }
               lastA = h.actRate; lastM = h.mktRate;
           }
       });

       document.getElementById('matHistTitle').innerHTML = `<i class="fas fa-search-dollar text-primary me-2"></i>${matName}`;
       document.getElementById('matHistUnit').innerText = `Rate per ${unitStr}`;

       // 3. BUILD TABLE (Priority-Based Logic)
       let tBody = '';
       let reversedTableData = [...tableData].reverse();

       reversedTableData.forEach((h, idx) => {
           let prev = reversedTableData[idx + 1]; // Previous chronologically
           let pctStr = '-'; let pctColor = 'text-muted';
           
           let actChanged = prev ? Math.abs(h.actRate - prev.actRate) > 0.01 : false;
           let isManualOverride = Math.abs(h.actRate - h.mktRate) > 0.01;

           // LOGIC PRIORITY 1: Check for Actual Price Change FIRST
           if (actChanged && prev.actRate > 0) {
               let pct = ((h.actRate - prev.actRate) / prev.actRate) * 100;
               if (Math.abs(pct) > 0.01) {
                   let icon = pct > 0 ? '<i class="fas fa-arrow-trend-up me-1"></i>' : '<i class="fas fa-arrow-trend-down me-1"></i>';
                   pctStr = `${icon}${Math.abs(pct).toFixed(1)}%`; 
                   pctColor = 'text-primary bg-primary bg-opacity-10 rounded px-2'; // BLUE
               } else { pctStr = '0%'; }
               
           // LOGIC PRIORITY 2: If Actual didn't change, check for Manual Market Override
           } else if (isManualOverride && h.actRate > 0) {
               let pct = ((h.mktRate - h.actRate) / h.actRate) * 100;
               if (Math.abs(pct) > 0.01) {
                   let icon = pct > 0 ? '<i class="fas fa-arrow-trend-up me-1"></i>' : '<i class="fas fa-arrow-trend-down me-1"></i>';
                   pctStr = `${icon}${Math.abs(pct).toFixed(1)}%`; 
                   pctColor = 'text-danger bg-danger bg-opacity-10 rounded px-2'; // RED
               } else { pctStr = '0%'; }
               
           // No changes at all
           } else if (prev) {
               pctStr = '0%';
           }

           // Fade Market Rate to 30% if it's just mirroring the Actual Rate
           let mktOpacity = isManualOverride ? '1' : '0.3';

           tBody += `<tr>
              <td class="text-dark fw-bold ps-3" style="font-size:0.8rem;">${h.date}</td>
              <td class="text-primary text-end fw-bold" style="font-size:0.8rem;">${h.actRate.toFixed(2)}</td>
              <td class="text-danger text-end fw-bold" style="font-size:0.8rem; opacity: ${mktOpacity}; transition: opacity 0.3s;">${h.mktRate.toFixed(2)}</td>
              <td class="text-end pe-3 fw-bold" style="font-size:0.8rem;"><span class="${pctColor}">${pctStr}</span></td>
           </tr>`;
       });
       
       document.getElementById('matHistTableBody').innerHTML = tBody;

       // 4. BUILD CHART
       let chartLabels = []; let actData = []; let mktData = [];
       history.forEach(h => {
           chartLabels.push(h.date);
           actData.push(h.actRate);
           mktData.push(h.mktRate);
       });

       const ctx = document.getElementById('matHistChart').getContext('2d');
       if (appState.matHistChartInstance) appState.matHistChartInstance.destroy();

       appState.matHistChartInstance = new Chart(ctx, {
           type: 'line',
           data: {
               labels: chartLabels,
               datasets: [
                   { label: 'Actual Rate', data: actData, borderColor: '#3b82f6', backgroundColor: '#3b82f6', tension: 0, stepped: 'middle', borderWidth: 2, pointRadius: 3, pointHoverRadius: 6 },
                   { label: 'Market Rate (Indicative)', data: mktData, borderColor: '#ef4444', backgroundColor: '#ef4444', tension: 0, stepped: 'middle', borderDash: [5,5], borderWidth: 2, pointRadius: 3, pointHoverRadius: 6 }
               ]
           },
           options: { 
               responsive: true, maintainAspectRatio: false, 
               interaction: { mode: 'index', intersect: false },
               plugins: { legend: { position: 'top' } }
           }
       });

       new bootstrap.Modal(document.getElementById('materialHistoryModal')).show();
    };

    // --- NEW: MARKET RATE MANAGEMENT TOOL ---
    appState.latestRates = {};

    window.openMarketUpdateModal = function() {
        let mats = {};
        
        // 1. Sort chronologically first, so the newest dates overwrite the oldest in the loop!
        let chronoData = [...appState.costingData].sort((a,b) => new Date(a.date) - new Date(b.date));
        
        chronoData.forEach(d => {
            if(d.bomMeta) {
                Object.keys(d.bomMeta).forEach(m => {
                    let a = d.bomMeta[m].actRate || 0;
                    let mkt = d.bomMeta[m].mktRate || d.bomMeta[m].rate || 0;
                    
                    // Failsafes for zero values
                    let actVal = (d.bomActual && d.bomActual[m]) ? d.bomActual[m] : 0;
                    let mktVal = (d.bomMarket && d.bomMarket[m]) ? d.bomMarket[m] : 0;
                    if (a === 0 && actVal > 0 && mktVal > 0 && mkt > 0) a = (actVal * mkt) / mktVal;
                    if (mkt === 0 && a > 0) mkt = a;

                    let u = d.bomMeta[m].unit || 'Unit';
                    if(a > 0 || mkt > 0) mats[m] = { act: a, mkt: mkt, unit: u }; // Continually overwrites = newest
                });
            }
        });
        appState.latestRates = mats;
        
        // 2. Build select dropdown
        let selectHtml = '<option value="">-- Select Material --</option>';
        Object.keys(mats).sort().forEach(m => { selectHtml += `<option value="${m}">${m}</option>`; });
        document.getElementById('mu-material').innerHTML = selectHtml;
        
        // 3. Reset form
        document.getElementById('mu-date').value = new Date().toISOString().split('T')[0];
        document.getElementById('mu-price').value = '';
        document.getElementById('mu-act-hint').innerHTML = '-';
        document.getElementById('mu-mkt-hint').innerHTML = '-';
        document.getElementById('mu-history-body').innerHTML = '<tr><td colspan="3" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>Loading history...</td></tr>';
        
        // 4. Fetch update history asynchronously
        google.script.run.withSuccessHandler(res => {
            let trs = res.map(r => `<tr><td class="text-muted" style="font-size:0.8rem;">${r.date}</td><td class="fw-bold text-dark" style="font-size:0.8rem;">${r.material}</td><td class="text-end text-danger fw-bold" style="font-size:0.8rem;">${r.price}</td></tr>`).join('');
            document.getElementById('mu-history-body').innerHTML = trs || '<tr><td colspan="3" class="text-center text-muted">No manual updates found.</td></tr>';
            
            // CROSS-REFERENCE: Ensure the "Latest Market" hint reflects the absolute newest manual override!
            [...res].reverse().forEach(r => { 
                if (appState.latestRates[r.material]) {
                    appState.latestRates[r.material].mkt = Number(r.price);
                }
            });
            
            // Auto-refresh the hint UI if the user already selected a material before history loaded
            let selectedMat = document.getElementById('mu-material').value;
            if (selectedMat) onMuMaterialChange(selectedMat);

        }).getManualUpdates();
        
        new bootstrap.Modal(document.getElementById('marketUpdateModal')).show();
    };

