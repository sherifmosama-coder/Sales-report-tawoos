  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <script>
    // --- COLORS ---
    const COLORS = {
      'All Years': '#1e293b', '2026': '#dc3545', '2025': '#198754', '2024': '#0d6efd', '2023': '#6f42c1', '2022': '#fd7e14', '2021': '#6c757d',
      'جملة': '#f59e0b', 'تجزئة': '#0ea5e9', 'سلاسل': '#3b82f6', 'مطعم': '#ef4444', 'اون لاين': '#8b5cf6', 'All Types': '#1e293b'
    };
    function getColor(k) { return COLORS[k] || (k.includes('جملة')?COLORS['جملة']:k.includes('تجزئة')?COLORS['تجزئة']:k.includes('مطعم')?COLORS['مطعم']:'#94a3b8'); }

    // --- STATE ---
    // Segment Icon Mapping
    const segmentIcons = {
      "تجزئة": "fa-store",
      "جملة": "fa-boxes-stacked",
      "مطعم": "fa-utensils",
      "سلاسل": "fa-building",
      "سرجة / عطارة": "fa-mortar-pestle",
      "اون لاين": "fa-globe",
      "اخرين": "fa-layer-group"
    };

    function getSegmentHTML(type) {
      const icon = segmentIcons[type] || "fa-tag";
      return `<span class="badge bg-light text-dark border"><i class="fas ${icon} me-1 text-primary"></i> ${type}</span>`;
    }

    let appState = {
      mode: 'client', 
      timeScope: 'YTD', // NEW: Client Dashboard Timeline Scope
      rawData: [],
      productData: [],
      netSalesData: [], // NEW: Contract & Commercial Terms Data
      selectedYear: 'All',
      selectedType: 'All',
      viewMode: 'qty',
      pFilters: { segment: 'All', category: 'All', line: 'All', item: 'All' },
      pChart: null,
      sortBy: 'qty',
      groupBy: 'None',
      chartInstance: null,
      modalChartInstance: null,
      pCompareYears: [], // Dynamic array of selected past years
      pChartViewMode: 'detailed', // Default view
      pYearlyTrend: null, // Holds data for the Drill Down
      pCompareTarget: true, // Target Toggle (ON by default)
      targetConfig: { yoy: 25, mom: 30 },
      pMasterItems: {}, 
      kpiModalState: { type: 'value', targetId: 'current', viewLevel: 'category' },
      
      // NEW: Costing Engine State
      costingData: [],
      netSalesData: [], // NEW: Contract & Commercial Terms Data
      cFilters: { category: 'All', product: 'All', view: 'compare', timeline: 'weekly', year: new Date().getFullYear().toString() },
      execState: { isSummary: true, isCompare: true, baseDate: '2026-03-01' },
      cDoughnutChart: null,
      cChartInstance: null,
      bomChartInstance: null
    };

    function toggleCompareTarget() {
       // Ensure at least 1 comparison parameter remains active (Target OR a Year)
       if (appState.pCompareTarget && appState.pCompareYears.length === 0) return;
       appState.pCompareTarget = !appState.pCompareTarget;
       renderProductDashboard();
    }

    function openTargetConfig() {
       document.getElementById('conf-yoy').value = appState.targetConfig.yoy;
       document.getElementById('conf-mom').value = appState.targetConfig.mom;
       new bootstrap.Modal(document.getElementById('targetConfigModal')).show();
    }

    function saveTargetConfig() {
       appState.targetConfig.yoy = parseFloat(document.getElementById('conf-yoy').value) || 0;
       appState.targetConfig.mom = parseFloat(document.getElementById('conf-mom').value) || 0;
       document.getElementById('target-note-text').innerText = `Target: +${appState.targetConfig.yoy}% YoY (Established) | +${appState.targetConfig.mom}% MoM (New)`;
       bootstrap.Modal.getInstance(document.getElementById('targetConfigModal')).hide();
       renderProductDashboard();
    }

    function setChartViewMode(mode) {
       appState.pChartViewMode = mode;
       renderProductDashboard();
    }

    function toggleCompareYear(year) {
       const idx = appState.pCompareYears.indexOf(year);
       if (idx > -1) {
          // Ensure at least 1 comparison parameter remains active (Target OR a Year)
          if (appState.pCompareYears.length > 1 || appState.pCompareTarget) {
              appState.pCompareYears.splice(idx, 1);
          }
       } else {
          appState.pCompareYears.push(year);
       }
       appState.pCompareYears.sort((a, b) => b - a);
       renderProductDashboard();
    }
    
    // No auto-init. Wait for user selection.
    window.onload = function() {
       console.log("App Loaded. Waiting for source selection...");
       // FIX: Hide the loader so the Landing Screen is visible
       document.getElementById('smart-loader').style.display = 'none';
    };

    let loaderInterval;
    let progressInterval;
    let syncInterval;
    
    function switchModule(mode) {
       if (mode === appState.mode) return;
       appState.mode = mode;
       
       // 1. Update the Floating Navigator UI
       document.getElementById('nav-btn-client').className = mode === 'client' ? 'nav-btn active' : 'nav-btn';
       document.getElementById('nav-btn-product').className = mode === 'product' ? 'nav-btn active' : 'nav-btn';
       document.getElementById('nav-btn-costing').className = mode === 'costing' ? 'nav-btn active' : 'nav-btn';

       // 2. Force Hide ALL containers safely
       document.getElementById('client-view-container').style.display = 'none';
       document.getElementById('product-controls').style.display = 'none';
       document.getElementById('product-content-area').style.display = 'none';
       document.getElementById('costing-view-container').style.display = 'none';

       // 3. Route to the correct view
       if (mode === 'product') {
          if (!appState.productData || appState.productData.length === 0) { loadSource('product'); } 
          else { initProductView(); }
       } else if (mode === 'costing') {
          if (!appState.costingData || appState.costingData.length === 0) { loadSource('costing'); } 
          else { initCostingView(); }
       } else {
          if (!appState.rawData || appState.rawData.length === 0) { loadSource('client'); } 
          else { initClientView(); }
       }
    }

    function loadSource(mode) {
      appState.mode = mode;

      // ==========================================
      // 1. IN-MEMORY CACHE (INSTANT VIEW SWITCHING)
      // ==========================================
      let hasData = false;
      if (mode === 'client' && appState.rawData && appState.rawData.length > 0) hasData = true;
      if (mode === 'product' && appState.productData && appState.productData.length > 0) hasData = true;
      if (mode === 'costing' && appState.costingData && appState.costingData.length > 0 && appState.productData && appState.productData.length > 0) hasData = true;

      if (hasData) {
          document.getElementById('landing-screen').style.display = 'none';
          document.getElementById('smart-loader').style.display = 'none';
          document.getElementById('main-dashboard').style.display = 'none'; 
          document.getElementById('floating-navigator').style.display = 'flex';
          
          document.getElementById('nav-btn-client').className = mode === 'client' ? 'nav-btn active' : 'nav-btn';
          document.getElementById('nav-btn-product').className = mode === 'product' ? 'nav-btn active' : 'nav-btn';
          document.getElementById('nav-btn-costing').className = mode === 'costing' ? 'nav-btn active' : 'nav-btn';
          
          if (mode === 'product') {
             if (!document.getElementById('report-date').value) document.getElementById('report-date').valueAsDate = new Date();
             
             // BUG FIX: Restore pristine data just in case the Costing engine mutated the master array!
             if (appState.pristineProductData) {
                 appState.productData = JSON.parse(JSON.stringify(appState.pristineProductData));
             }
             initProductView();
          } else if (mode === 'costing') {
             initCostingView();
          } else {
             initClientView();
          }
          return; // Instantly bypass the server fetch
      }

      // ==========================================
      // 2. FETCH FROM SERVER (FIRST LOAD ONLY)
      // ==========================================
      document.getElementById('landing-screen').style.display = 'none';
      document.getElementById('main-dashboard').style.display = 'none';
      document.getElementById('floating-navigator').style.display = 'none';

      const loader = document.getElementById('smart-loader');
      const icon = document.getElementById('loader-icon');
      const title = document.getElementById('loader-title');
      const insightEl = document.getElementById('loader-insight');
      
      let insights = [];
      if (mode === 'client') {
         icon.className = 'fas fa-users-viewfinder text-primary';
         document.getElementById('loader-icon-box').style.color = '#3b82f6';
         title.innerText = "Clients' Sales across Years";
         insights = ["Mapping client Orders...", "Analyzing longitudinal order frequencies...", "Calculating risk of losing clients...", "Rendering client behavior segments..."];
      } else if (mode === 'product') {
         icon.className = 'fas fa-boxes text-success';
         document.getElementById('loader-icon-box').style.color = '#10b981';
         title.innerText = "Product Trends & Trajectories";
         insights = ["Fetching historical product performance...", "Aligning SKU variants...", "Calculating category growth...", "Preparing seasonal trend charts..."];
      } else if (mode === 'costing') {
         icon.className = 'fas fa-calculator text-warning';
         document.getElementById('loader-icon-box').style.color = '#f59e0b';
         title.innerText = "Live Cost Engine & Margins";
         insights = ["Syncing Bill of Materials...", "Updating latest raw material costs...", "Calculating direct labor overheads...", "Evaluating target margins..."];
      }

      loader.style.display = 'flex';
      
      let progress = 0;
      const loaderBar = document.getElementById('loader-progress-bar');
      loaderBar.style.width = '0%';
      clearInterval(progressInterval);
      
      progressInterval = setInterval(() => {
         progress += 0.475;
         if (progress > 95) progress = 95;
         loaderBar.style.width = progress + '%';
      }, 100);

      let insightIdx = 0;
      insightEl.innerText = insights[0];
      clearInterval(loaderInterval);
      loaderInterval = setInterval(() => {
         insightEl.classList.remove('active');
         setTimeout(() => {
            insightIdx = (insightIdx + 1) % insights.length;
            insightEl.innerText = insights[insightIdx];
            insightEl.classList.add('active');
         }, 400); 
      }, 2500);

      let backendFn = 'getDashboardDataFromCache'; 
      if (mode === 'product') backendFn = 'getProductDataFromCache';
      if (mode === 'costing') backendFn = 'getCostingDataFromCache';

      google.script.run
        .withSuccessHandler(response => {
          
          const finishLoad = (modeToInit) => {
             clearInterval(loaderInterval); 
             clearInterval(progressInterval); 
             document.getElementById('loader-progress-bar').style.width = '100%';
             setTimeout(() => {
                document.getElementById('smart-loader').style.display = 'none';
                document.getElementById('floating-navigator').style.display = 'flex';
                document.getElementById('nav-btn-client').className = modeToInit === 'client' ? 'nav-btn active' : 'nav-btn';
                document.getElementById('nav-btn-product').className = modeToInit === 'product' ? 'nav-btn active' : 'nav-btn';
                document.getElementById('nav-btn-costing').className = modeToInit === 'costing' ? 'nav-btn active' : 'nav-btn';
                
                if (modeToInit === 'product') {
                   document.getElementById('report-date').valueAsDate = new Date();
                   initProductView();
                } else if (modeToInit === 'costing') {
                   initCostingView();
                } else {
                   initClientView();
                }
             }, 300);
          };

          if (!response) { alert("System Alert: Unable to retrieve dataset."); return; }

          if (mode === 'product') {
             if (!response.data) { alert("System Alert: Product Dataset error."); return; }
             
             appState.productData = response.data;
             appState.pristineProductData = JSON.parse(JSON.stringify(response.data)); 
             
             let syncTime = new Date(response.lastUpdated).toLocaleTimeString('en-US', {hour: '2-digit', minute:'2-digit'});
             let dataDate = response.latestData || 'Unknown';
             let syncText = document.getElementById('product-last-sync');
             if(syncText) syncText.innerHTML = `<span class="text-primary fw-bold">Synced: ${syncTime}</span><br><span class="text-success fw-bold" style="font-size: 0.55rem;">Data: ${dataDate}</span>`;

             finishLoad('product');

          } else if (mode === 'client') {
             if (!response.data) { alert("System Alert: Dataset error."); return; }
             appState.rawData = response.data;
             
             let syncTime = new Date(response.lastUpdated).toLocaleTimeString('en-US', {hour: '2-digit', minute:'2-digit'});
             let dataDate = response.latestData || 'Unknown';
             let syncText = document.getElementById('main-last-sync');
             if(syncText) syncText.innerHTML = `<span class="text-primary fw-bold">Synced: ${syncTime}</span><br><span class="text-success fw-bold" style="font-size: 0.55rem;">Data: ${dataDate}</span>`;

             finishLoad('client');
             if (typeof runCadenceScanner === 'function') setTimeout(runCadenceScanner, 500);
             
          } else if (mode === 'costing') {
             if (response.error) { alert("Cost Engine Error: " + response.error); return; }
             if (!response.data) { alert("System Alert: Costing Dataset error."); return; }
             appState.costingData = response.data;
             
             let syncTime = new Date(response.lastUpdated).toLocaleTimeString('en-US', {hour: '2-digit', minute:'2-digit'});
             let dataDate = response.latestData || 'Unknown';
             let syncText = document.getElementById('costing-last-sync');
             if(syncText) syncText.innerHTML = `<span class="text-primary fw-bold">Synced: ${syncTime}</span><br><span class="text-success fw-bold" style="font-size: 0.55rem;">Data: ${dataDate}</span>`;
             
             // NEW: Fetch Net Sales (Commercial Terms) before finalizing the Costing view
             document.getElementById('loader-insight').innerText = "Applying commercial terms & contracts...";
             google.script.run.withSuccessHandler(netRes => {
                 if (netRes && netRes.data) appState.netSalesData = netRes.data;
                 
                 // Fallback: Check if Product Data needs to be loaded
                 if (!appState.productData || appState.productData.length === 0) {
                     document.getElementById('loader-insight').innerText = "Cross-referencing sales ledger...";
                     google.script.run.withSuccessHandler(prodRes => {
                         if (prodRes && prodRes.data) {
                             appState.productData = prodRes.data;
                             appState.pristineProductData = JSON.parse(JSON.stringify(prodRes.data)); 
                             
                             let prodTime = new Date(prodRes.lastUpdated).toLocaleTimeString('en-US', {hour: '2-digit', minute:'2-digit'});
                             let pText = document.getElementById('product-last-sync');
                             if(pText) pText.innerText = "Updated " + prodTime;
                         } else {
                             appState.productData = [];
                         }
                         finishLoad('costing');
                     }).getProductDataFromCache();
                 } else {
                     finishLoad('costing');
                 }
             }).getNetSalesDataFromCache();
          }
        })
        .withFailureHandler(error => {
            alert("Server Error: " + error.message);
            document.getElementById('smart-loader').style.display = 'none';
            document.getElementById('landing-screen').style.display = 'block';
        })[backendFn]();
    }

    function initClientView() {
       document.getElementById('main-dashboard').style.display = 'block';
       
       // Show Client Container
       document.getElementById('client-view-container').style.display = 'block';
       
       // Hide Product & Costing Containers
       document.getElementById('product-controls').style.display = 'none';
       document.getElementById('product-content-area').style.display = 'none';
       document.getElementById('costing-view-container').style.display = 'none'; // NEW: Hide Costing

       renderDashboard(); 
      // Inside your client dashboard initialization function
      runCadenceScanner(); 
    }

    function initProductView() {
       document.getElementById('main-dashboard').style.display = 'block';
       
       // Hide Client & Costing Containers
       document.getElementById('client-view-container').style.display = 'none';
       document.getElementById('costing-view-container').style.display = 'none'; // NEW: Hide Costing
       
       // Show Product Container
       document.getElementById('product-controls').style.display = 'block';
       document.getElementById('product-content-area').style.display = 'block';

       // Init Filters if empty
       const categories = [...new Set(appState.productData.map(d => d.category))].sort();
       const catContainer = document.getElementById('filter-category-container');
       
       // Default comparison: Target is ON by default, no past years needed initially
       if (appState.pCompareYears.length === 0 && !appState.pCompareTarget) {
          appState.pCompareTarget = true; // Fallback in case both are empty
       }

       // --- NEW: Generate Dynamic Segment UI ---
       const segContainer = document.getElementById('filter-segment-container');
       if (segContainer && segContainer.children.length <= 2) { 
           let uniqueSegments = new Set();
           appState.productData.forEach(d => { if(d.segments) Object.keys(d.segments).forEach(s => uniqueSegments.add(s)); });
           
           let segHtml = `<input type="radio" class="btn-check" name="filter-segment" id="seg-all" value="All" checked onchange="updateProductState('segment', 'All')">
                          <label for="seg-all" class="flex-fill text-center px-3"><i class="fas fa-layer-group me-1"></i>All</label>`;
           
           Array.from(uniqueSegments).sort().forEach((seg, idx) => {
              const safeId = 'seg-' + idx;
              segHtml += `<input type="radio" class="btn-check" name="filter-segment" id="${safeId}" value="${seg}" onchange="updateProductState('segment', '${seg}')">
                          <label for="${safeId}" class="flex-fill text-center px-3">${seg}</label>`;
           });
