    function renderDynamicKPIs(currTotal, comparisons, startCurr, endCurr, measure, targetData) {
       const container = document.getElementById('dynamic-kpi-section');
       const dateFmt = (d) => d.toLocaleDateString('en-GB', { month: 'short', day: 'numeric' });
       const fmt = (n) => measure === 'rev' ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'EGP', maximumFractionDigits:0 }).format(n) : formatK(n);
       const currStr = `${dateFmt(startCurr)} - ${dateFmt(endCurr)}, ${startCurr.getFullYear()}`;

