    function aggregateForList(data) {
      // SAFETY CHECK: If data is missing, return empty list to prevent crash
      if (!data || !Array.isArray(data)) {
        console.warn("aggregateForList received invalid data:", data);
        return [];
      }

      const map = {};
      
      const currentYear = new Date().getFullYear();
      let lastFinishedYear = currentYear - 1;     
      let previousFinishedYear = currentYear - 2; 

      // DYNAMIC GROWTH COMPARISON: If scoped (YTD/QTD/MTD), compare Current Year vs Last Year
      if (appState.timeScope !== 'FULL') {
          lastFinishedYear = currentYear;
          previousFinishedYear = currentYear - 1;
      }

      data.forEach(d => {
        // Group by Main Client (d.client)
        if (!map[d.client]) {
          map[d.client] = { 
            name: d.client, 
            client: d.client, // Ensure 'client' property exists for compatibility
            type: d.type, 
            qty: 0, rev: 0, orders: 0, lastTx: '',
            qLast: 0, qPrev: 0, rLast: 0, rPrev: 0 
          };
        }
        
        const c = map[d.client];
        
        // Aggregate Totals (All Years)
        c.qty += d.qty; c.rev += d.rev;
        c.orders += d.orders;
        if (d.lastTx > c.lastTx) c.lastTx = d.lastTx;

        // Capture Specific Years for Growth Calculation
        if (d.year == lastFinishedYear) { c.qLast += d.qty; c.rLast += d.rev; }
        if (d.year == previousFinishedYear) { c.qPrev += d.qty; c.rPrev += d.rev; }
      });

      return Object.values(map).map(c => {
        c.avg = c.orders > 0 ? Math.round(c.qty / c.orders) : 0;
        
        // GROWTH LOGIC: Compare Last Finished vs Previous Finished
        // e.g., (2025 - 2024) / 2024
        if (appState.viewMode === 'rev') {
           c.growth = c.rPrev > 0 ? (c.rLast - c.rPrev) / c.rPrev : null;
        } else {
           c.growth = c.qPrev > 0 ? (c.qLast - c.qPrev) / c.qPrev : null;
        }
        
        // Helper string for last transaction
        c.lastTxStr = c.lastTx;

        return c;
      });
    }

