    function updateProductChart(currTrend, comparisons, start, end, pBuckets, pData, currentYear, targetData) {
       const ctx = document.getElementById('productTrendChart').getContext('2d');
       if(appState.pChart) appState.pChart.destroy();
       
       const histColors = ['#3b82f6', '#8b5cf6', '#ec4899', '#64748b'];
       let datasets = []; let labels = [];

       if (appState.pChartViewMode === 'detailed') {
          let cData = []; let cAcc = 0; let tData = []; let tAcc = 0;
          comparisons.forEach(comp => { comp.dataArray = []; comp.acc = 0; });

          for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
             const key = ('0' + (d.getMonth()+1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
             labels.push(key);
             cAcc += (currTrend[key] || 0); cData.push(cAcc);
             if (targetData.active) { tAcc += (targetData.trend[key] || 0); tData.push(tAcc); }
             comparisons.forEach(comp => { comp.acc += (comp.trend[key] || 0); comp.dataArray.push(comp.acc); });
          }

          datasets.push({ label: `Current (${start.getFullYear()})`, data: cData, borderColor: '#16a34a', backgroundColor: 'rgba(22, 163, 74, 0.1)', fill: true, tension: 0.3, borderWidth: 3 });
          if (targetData.active) datasets.push({ label: '🎯 Target', data: tData, borderColor: '#f59e0b', fill: false, tension: 0.3, borderWidth: 3 });
          comparisons.forEach((comp, idx) => datasets.push({ label: `Past (${comp.year})`, data: comp.dataArray, borderColor: histColors[idx % histColors.length], borderDash: [4, 4], fill: false, tension: 0.3, borderWidth: 2 }));
       } else {
          labels = pBuckets;
          datasets.push({ label: `Current (${currentYear})`, data: pBuckets.map(b => pData.curr[b] || 0), backgroundColor: '#16a34a', borderRadius: 4 });
          if (targetData.active) datasets.push({ label: '🎯 Target', data: pBuckets.map(b => targetData.pData[b] || 0), backgroundColor: '#fbbf24', borderColor: '#d97706', borderWidth: 2, borderRadius: 4 });
          comparisons.forEach((comp, idx) => datasets.push({ label: `Past (${comp.year})`, data: pBuckets.map(b => pData[comp.year][b] || 0), backgroundColor: histColors[idx % histColors.length] + 'CC', borderRadius: 4 }));
       }

       appState.pChart = new Chart(ctx, {
          type: appState.pChartViewMode === 'detailed' ? 'line' : 'bar',
          data: { labels: labels, datasets: datasets },
          options: { 
             responsive: true, 
             maintainAspectRatio: false, 
             plugins: { legend: { position: 'top' } }, 
             scales: { x: { display: appState.pChartViewMode !== 'detailed' } },
             onClick: (e, elements) => {
                if (appState.pChartViewMode === 'periodic' && elements.length) {
                   // Pass the Target Data to the drill-down modal!
                   openDrillDown(labels[elements[0].index], currentYear, comparisons, targetData);
                }
             },
             onHover: (e, elements) => { 
                if (appState.pChartViewMode === 'periodic') {
                   e.native.target.style.cursor = elements.length ? 'pointer' : 'default'; 
                }
             }
          }
       });
    }

