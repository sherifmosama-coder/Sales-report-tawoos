    function updateMainChart() {
      const ctx = document.getElementById('mainChart').getContext('2d');
      if (appState.chartInstance) appState.chartInstance.destroy();
      let labels=[], data=[], bg=[];
      let type = 'bar';
      
      if (appState.selectedYear === 'All') {
         type = 'line';
         [2021,2022,2023,2024,2025,2026].forEach(y => {
            const v = appState.rawData.filter(d => d.year==y && (appState.selectedType==='All'||d.type===appState.selectedType)).reduce((s,r)=>s+(r[appState.viewMode]||0),0);
            labels.push(y); data.push(v); bg.push(COLORS[y]);
         });
      } else {
         type = 'doughnut';
         const yrData = appState.rawData.filter(d => d.year==appState.selectedYear);
         const map={}; yrData.forEach(d=>{const t=d.type||'Other'; map[t]=(map[t]||0)+(d[appState.viewMode]||0);});
         const s = Object.entries(map).sort((a,b)=>b[1]-a[1]).slice(0,6);
         labels=s.map(x=>x[0]); data=s.map(x=>x[1]); bg=labels.map(l=>getColor(l));
      }

      appState.chartInstance = new Chart(ctx, {
         type: type,
         data: { labels: labels, datasets: [{ label: appState.viewMode==='rev'?'Revenue':'Qty', data:data, backgroundColor:bg, borderColor: type==='line'?'#334155':'white', pointBackgroundColor:bg, fill:true, tension:0.3 }] },
         options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:type==='doughnut', position:'right'}}, scales:{x:{grid:{display:false}}, y:{display:type!=='doughnut', grid:{display:false}}} }
      });
    }

    function openModal(name, type) {
       const m = new bootstrap.Modal(document.getElementById('detailModal'));
       document.getElementById('modalTitle').innerText = name;
       const b = document.getElementById('modalSubtitle'); b.innerText = type; b.style.backgroundColor = getColor(type);

       // 1. Get all raw rows for this Main Client (includes all branches)
       const clientRows = appState.rawData.filter(d => d.client === name);

       // 2. Aggregate by YEAR for the Chart & Top Table
       const yearMap = {};
       clientRows.forEach(r => {
          if (!yearMap[r.year]) yearMap[r.year] = { qty: 0, orders: 0 };
          yearMap[r.year].qty += r.qty;
          yearMap[r.year].orders += r.orders;
       });

       // Render Top Table (Yearly Performance)
       const tbody = document.getElementById('modalBody'); tbody.innerHTML = '';
       let lbl=[], dta=[], bg=[];
       
       [2021,2022,2023,2024,2025,2026].forEach(y => {
          const d = yearMap[y];
          const q = d ? d.qty : 0;
          const o = d ? d.orders : 0;
          
          if(q > 0 || o > 0) {
             lbl.push(y); dta.push(q); bg.push(COLORS[y]);
             tbody.innerHTML += `<tr>
                <td style="color:${COLORS[y]}; font-weight:bold">${y}</td>
                <td>${formatK(q)}</td>
                <td>${o}</td>
                <td>${o>0 ? (q/o).toFixed(0) : 0}</td>
             </tr>`;
          }
       });

       // 3. Aggregate by BRANCH for the Bottom Table
       const branchMap = {};
       clientRows.forEach(r => {
          if (!branchMap[r.branch]) branchMap[r.branch] = { name: r.branch, qty: 0, orders: 0, lastTx: '' };
          const b = branchMap[r.branch];
          b.qty += r.qty;
          b.orders += r.orders;
          if (r.lastTx > b.lastTx) b.lastTx = r.lastTx;
       });
       
       // Sort branches by Volume
       const sortedBranches = Object.values(branchMap).sort((a,b) => b.qty - a.qty);

       // Render Branch Table
       const branchTable = document.getElementById('modalBranchBody');
       if (branchTable) {
           branchTable.innerHTML = '';
           sortedBranches.forEach(b => {
               branchTable.innerHTML += `<tr>
                  <td class="text-start fw-bold text-secondary">${b.name}</td>
