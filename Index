    // --- NEW: MATERIAL HISTORY DRILL-DOWN ENGINE ---
    appState.matHistChartInstance = null; 

    window.openMaterialHistory = function(matName) {
       let chronoData = [...appState.costingData].sort((a,b) => new Date(a.date) - new Date(b.date));
       
       let history = [];
       let unitStr = 'Unit';
       let lastKnownActRate = 0;

       // 1. EXTRACT DATA & FIX MISSING VALUES
       chronoData.forEach(d => {
           if (d.bomMeta && d.bomMeta[matName]) {
               let a = d.bomMeta[matName].actRate || 0;
               let m = d.bomMeta[matName].mktRate || d.bomMeta[matName].rate || 0;
               
               // Reverse-engineer missing Actual from BOM ratios
               let actVal = (d.bomActual && d.bomActual[matName]) ? d.bomActual[matName] : 0;
               let mktVal = (d.bomMarket && d.bomMarket[matName]) ? d.bomMarket[matName] : 0;
               if (a === 0 && actVal > 0 && mktVal > 0 && m > 0) a = (actVal * m) / mktVal;

               // Inherit the last known Actual Rate if FIFO queue was empty
               if (a === 0 && lastKnownActRate > 0) a = lastKnownActRate;
               if (a === 0 && m > 0 && lastKnownActRate === 0) a = m;
               
               if (a > 0) lastKnownActRate = a;

               // CRITICAL FIX: Market Rate MUST equal Actual Rate unless explicitly overridden
               if (m === 0 && a > 0) m = a;
               
               if (a === 0 && m === 0) return; // Skip complete zeros
               
               unitStr = d.bomMeta[matName].unit || 'Unit';
               history.push({ date: d.date, actRate: a, mktRate: m });
           }
       });

       if (history.length === 0) return;

       // 2. ISOLATE TRUE SHIFTS (Manual Updates or Actual Purchase Shifts)
       let tableData = [];
       let lastA = -1; let lastM = -1;

       history.forEach((h, idx) => {
           let isFirst = idx === 0;
           let isLast = idx === history.length - 1;
           let isShift = (Math.abs(h.actRate - lastA) > 0.01 || Math.abs(h.mktRate - lastM) > 0.01);

           if (isFirst || isLast || isShift) {
               if (tableData.length > 0 && tableData[tableData.length - 1].date === h.date) {
                   tableData[tableData.length - 1] = h; // Update in place if same date
               } else {
                   tableData.push(h);
               }
               lastA = h.actRate; lastM = h.mktRate;
           }
       });

       document.getElementById('matHistTitle').innerHTML = `<i class="fas fa-search-dollar text-primary me-2"></i>${matName}`;
       document.getElementById('matHistUnit').innerText = `Rate per ${unitStr}`;

       // 3. BUILD TABLE (Priority-Based Logic)
       let tBody = '';
       let reversedTableData = [...tableData].reverse();

       reversedTableData.forEach((h, idx) => {
           let prev = reversedTableData[idx + 1]; // Previous chronologically
           let pctStr = '-'; let pctColor = 'text-muted';
           
           let actChanged = prev ? Math.abs(h.actRate - prev.actRate) > 0.01 : false;
           let isManualOverride = Math.abs(h.actRate - h.mktRate) > 0.01;

           // LOGIC PRIORITY 1: Check for Actual Price Change FIRST
           if (actChanged && prev.actRate > 0) {
               let pct = ((h.actRate - prev.actRate) / prev.actRate) * 100;
               if (Math.abs(pct) > 0.01) {
                   let icon = pct > 0 ? '<i class="fas fa-arrow-trend-up me-1"></i>' : '<i class="fas fa-arrow-trend-down me-1"></i>';
                   pctStr = `${icon}${Math.abs(pct).toFixed(1)}%`; 
                   pctColor = 'text-primary bg-primary bg-opacity-10 rounded px-2'; // BLUE
               } else { pctStr = '0%'; }
               
           // LOGIC PRIORITY 2: If Actual didn't change, check for Manual Market Override
           } else if (isManualOverride && h.actRate > 0) {
               let pct = ((h.mktRate - h.actRate) / h.actRate) * 100;
               if (Math.abs(pct) > 0.01) {
                   let icon = pct > 0 ? '<i class="fas fa-arrow-trend-up me-1"></i>' : '<i class="fas fa-arrow-trend-down me-1"></i>';
                   pctStr = `${icon}${Math.abs(pct).toFixed(1)}%`; 
                   pctColor = 'text-danger bg-danger bg-opacity-10 rounded px-2'; // RED
               } else { pctStr = '0%'; }
               
           // No changes at all
           } else if (prev) {
               pctStr = '0%';
           }

           // Fade Market Rate to 30% if it's just mirroring the Actual Rate
           let mktOpacity = isManualOverride ? '1' : '0.3';

